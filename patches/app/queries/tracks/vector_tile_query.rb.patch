@@ -145,7 +153,35 @@
     SQL
   end
 
+  # dawarich-custom: a track under a cut stretch is clipped too (rebuilt from
+  # its points without that stretch); a track without points keeps its line,
+  # and no covered range at all (NULL) cuts nothing
   def clipped_track_predicate
+    return range_clipped_predicate unless hiding?
+
+    <<~SQL.squish
+      (#{range_clipped_predicate}) OR (COALESCE(#{covered_ranges} && int8range(EXTRACT(EPOCH FROM tracks.start_at)::bigint,
+        EXTRACT(EPOCH FROM tracks.end_at)::bigint, '[]'), false)
+        AND EXISTS (SELECT 1 FROM points WHERE points.track_id = tracks.id))
+    SQL
+  end
+
+  def hiding?
+    @hide_ranges_sql.present? && @clip_points_scope && @clip_start_at && @clip_end_at && !@clip_import_id &&
+      z >= HIDE_MIN_ZOOM
+  end
+
+  def covered_cte
+    hiding? ? "covered AS MATERIALIZED (SELECT (#{@hide_ranges_sql}) AS ranges), " : ''
+  end
+
+  def covered_ranges = '(SELECT ranges FROM covered)'
+
+  def hidden_segment_sql
+    "#{covered_ranges} @> int8range(previous_timestamp::bigint, timestamp::bigint, '[)')"
+  end
+
+  def range_clipped_predicate
     return 'false' unless @clip_points_scope
     return 'true' if @clip_import_id || !(@clip_start_at && @clip_end_at)
 
