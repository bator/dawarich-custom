+  /**
+   * Toggle the GTFS public transport layer (lazy-loads on first enable).
+   */
+  async toggleTransit(event) {
+    const enabled = event.target.checked
+    SettingsManager.updateSetting("transitEnabled", enabled)
+    this.layerManager.updateTrackCutouts()
+    const transitLayer = this.layerManager.getLayer("transit")
+    if (!transitLayer) return
+
+    try {
+      if (enabled) {
+        if (!(transitLayer.data?.features?.length > 0)) {
+          await this.reloadTransit()
+        }
+        transitLayer.show()
+      } else {
+        transitLayer.hide()
+      }
+    } catch (error) {
+      console.error("Failed to toggle transit layer:", error)
+      Toast.error(tr("failed"))
+    }
+  }
+
+  /**
+   * Filter the transit layer by mode (bus, tram, rail, ...).
+   */
+  changeTransitMode(event) {
+    const mode = event.target.value || "all"
+    SettingsManager.updateSetting("transitMode", mode)
+    this.layerManager.getLayer("transit")?.setMode(mode)
+    this.layerManager.updateTrackCutouts()
+  }
+
+  /**
+   * Toggle the walking legs next to the rides (lazy-loads on first enable).
+   */
+  async toggleWalkLegs(event) {
+    const enabled = event.target.checked
+    SettingsManager.updateSetting("walkLegsEnabled", enabled)
+    this.layerManager.updateTrackCutouts()
+    const layer = this.layerManager.getLayer("walkLegs")
+    if (!layer) return
+
+    try {
+      if (enabled) {
+        if (!(layer.data?.features?.length > 0)) {
+          await this.reloadWalkLegs()
+        }
+        layer.show()
+      } else {
+        layer.hide()
+      }
+    } catch (error) {
+      console.error("Failed to toggle walking legs layer:", error)
+      Toast.error(walkTr("failed_to_load"))
+    }
+  }
+
+  /**
+   * Toggle the frequent routes (loads them on first enable; not date bound).
+   */
+  async toggleCorridors(event) {
+    const enabled = event.target.checked
+    SettingsManager.updateSetting("corridorsEnabled", enabled)
+    const layer = this.layerManager.getLayer("corridors")
+    if (!layer) return
+
+    try {
+      if (enabled) {
+        if (!(layer.data?.features?.length > 0)) {
+          layer.update(await this.controller.api.fetchCorridors())
+        }
+        layer.show()
+      } else {
+        layer.hide()
+      }
+    } catch (error) {
+      console.error("Failed to toggle frequent routes layer:", error)
+      Toast.error(corridorTr("failed_to_load"))
+    }
+  }
+
+  async reloadWalkLegs() {
+    const layer = this.layerManager.getLayer("walkLegs")
+    if (!layer) return
+    const geojson = await this.controller.api.fetchWalkLegs({
+      start_at: this.controller.startDateValue,
+      end_at: this.controller.endDateValue,
+    })
+    layer.update(geojson)
+    const data = this.controller.mapDataManager?.lastLoadedData
+    if (data) data.walkLegsGeoJSON = geojson
+  }
+
+  async reloadTransit() {
+    const transitLayer = this.layerManager.getLayer("transit")
+    if (!transitLayer) return
+    const geojson = await this.controller.api.fetchTransitSegments({
+      start_at: this.controller.startDateValue,
+      end_at: this.controller.endDateValue,
+    })
+    transitLayer.update(geojson)
+    const data = this.controller.mapDataManager?.lastLoadedData
+    if (data) data.transitGeoJSON = geojson
+  }
+
+  /**
+   * Confirm / reject a ride from the map popup. A 404 means the ride was
+   * matched again in the meantime (review A2): reload the layer.
+   */
+  async reviewTransit(id, status, popup) {
+    try {
+      const result = await this.controller.api.updateTransitSegment(id, status)
+      popup?.remove()
+      if (result.reload) {
+        Toast.info(tr("reload"))
+      } else if (result.ok) {
+        Toast.success(tr(`done_${status}`))
+      } else {
+        Toast.error(tr("failed"))
+      }
+      await this.reloadTransit()
+      if (this.layerManager.getLayer("walkLegs")?.visible) {
+        await this.reloadWalkLegs()
+      }
+    } catch (error) {
+      console.error("Failed to review transit segment:", error)
+      Toast.error(tr("failed"))
+    }
+  }
