+  // dawarich-custom: the transit layer toggles and the ride mode select
+  syncTransitToggles() {
+    const controller = this.controller
+    for (const [targetName, settingKey] of [
+      ["transitToggle", "transitEnabled"],
+      ["walkLegsToggle", "walkLegsEnabled"],
+      ["corridorsToggle", "corridorsEnabled"],
+    ]) {
+      const hasTarget = `has${targetName.charAt(0).toUpperCase()}${targetName.slice(1)}Target`
+      if (controller[hasTarget])
+        controller[`${targetName}Target`].checked = this.settings[settingKey]
+    }
+    if (controller.hasTransitModeSelectTarget) {
+      controller.transitModeSelectTarget.value = this.settings.transitMode || "all"
+    }
   }
 
