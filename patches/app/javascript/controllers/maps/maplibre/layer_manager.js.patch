+          this.controller?.layerVisibilityManager?.reviewTransit(
+            id,
+            status,
+            popup,
+          ),
+      })
+      this.layers.transitLayer.add(transitGeoJSON)
+    } else {
+      this.layers.transitLayer.update(transitGeoJSON)
+    }
+  }
