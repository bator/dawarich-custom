--- a/config/schedule.yml
+++ b/config/schedule.yml
@@ -125,6 +125,52 @@
   class: "Stats::ToponymsRefreshJob"
   queue: stats
 
+gtfs_match_recent_job:
+  # before the feed sync below: decision K4 keeps only active + one backup timetable (docs/gtfs.md)
+  cron: "<%= ENV.fetch('GTFS_MATCH_CRON', '0 3 * * * Europe/Budapest') %>" # no-op unless GTFS_ENABLED=true
+  class: "Gtfs::MatchRecentJob"
+  queue: gtfs
+
+accuracy_gate_job:
+  # points worse than the user's gps_accuracy_threshold hidden (AccuracyGate), last 48 h
+  cron: "<%= ENV.fetch('ACCURACY_GATE_CRON', '41 * * * *') %>"
+  class: "AccuracyGateJob"
+  queue: default
+
+accuracy_gate_nightly_job:
+  # the same over all history (re-hides what an anomaly backfill showed again)
+  cron: "<%= ENV.fetch('ACCURACY_GATE_NIGHTLY_CRON', '50 4 * * * Europe/Budapest') %>"
+  class: "AccuracyGateJob"
+  args: [true]
+  queue: default
+
+gtfs_track_modes_job:
+  # transport mode of the track segments under confirmed rides, last 7 days (Gtfs::TrackModes)
+  cron: "<%= ENV.fetch('GTFS_TRACK_MODES_CRON', '*/20 * * * *') %>"
+  class: "Gtfs::TrackModesJob"
+  queue: gtfs
+
+gtfs_walk_today_job:
+  # today's walks snapped during the day, walks only: rides stay for the night (docs/atlas.md)
+  cron: "<%= ENV.fetch('GTFS_WALK_TODAY_CRON', '17 6-23 * * * Europe/Budapest') %>" # no-op unless GTFS_WALK_SNAP_ENABLED=true
+  class: "Gtfs::WalkTodayJob"
+  queue: gtfs
+
+gtfs_sync_all_feeds_job:
+  cron: "<%= ENV.fetch('GTFS_SYNC_CRON', '30 3 * * * Europe/Budapest') %>" # no-op unless GTFS_ENABLED=true
+  class: "Gtfs::SyncAllFeedsJob"
+  queue: gtfs
+
+corridors_rebuild_job:
+  cron: "<%= ENV.fetch('CORRIDORS_REBUILD_CRON', '15 4 * * 1 Europe/Budapest') %>" # no-op unless CORRIDORS_ENABLED=true
+  class: "Corridors::RebuildJob"
+  queue: low_priority
+
+corridors_snap_job:
+  cron: "<%= ENV.fetch('CORRIDORS_SNAP_CRON', '45 4 * * * Europe/Budapest') %>" # no-op unless CORRIDORS_SNAP_ENABLED=true
+  class: "Corridors::SnapJob"
+  queue: low_priority
+
 webhook_deliveries_cleanup_job:
   cron: "30 3 * * *" # every day at 03:30
   class: "Webhooks::CleanupDeliveriesJob"
