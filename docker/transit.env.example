# Environment of the custom code, read by the app, sidekiq and the Discord bot
# containers (docker-compose.transit.yml). Copy to transit.env next to the
# compose files. Never commit the real file: it may hold credentials.

# Master switch of the GTFS matching (jobs, pages and the daily sync are
# no-ops without it).
GTFS_ENABLED=true

# GTFS imports are heavy (millions of rows): one Sidekiq thread for the gtfs
# queue. Keep RAILS_MAX_THREADS >= BACKGROUND_PROCESSING_CONCURRENCY.
GTFS_QUEUE_CONCURRENCY=1
RAILS_MAX_THREADS=10

# Daily jobs (sidekiq-cron, with a time zone): match yesterday, then sync feeds.
#GTFS_MATCH_CRON=0 3 * * * Europe/Budapest
#GTFS_SYNC_CRON=30 3 * * * Europe/Budapest

# MÁV-START / GYSEV rail timetable: no public URL, access on request at
# https://www.mavcsoport.hu/gtfs-igenybejelento (HTTP Basic).
#GTFS_MAV_URL=
#GTFS_MAV_USERNAME=
#GTFS_MAV_PASSWORD=

# Discord bot. Everything except the app URL and the tile settings can also be
# set on /transit/discord (admins); a value saved there wins over these.
#DISCORD_TRANSIT_ENABLED=false
#DISCORD_BOT_TOKEN=
#DISCORD_TRANSIT_CHANNEL_ID=
#DISCORD_TRANSIT_ALLOWED_DISCORD_USER_IDS=
#DISCORD_TRANSIT_LOCALE=hu
# Base URL for the map links in the messages (default: APPLICATION_PROTOCOL + first APPLICATION_HOSTS entry)
#DISCORD_TRANSIT_APP_URL=https://dawarich.example.com

# Map image tiles (OpenStreetMap by default; its tile policy wants a contact).
#GTFS_MAP_TILE_CONTACT=you@example.com
#GTFS_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional, off by default: snap the walks next to rides to footpaths, through
# Dawarich Atlas (http://host:8484, POST /api/v1/map-match) or a raw Valhalla
# (http://host:8002, GTFS_WALK_VALHALLA_API=valhalla). A host that is not a
# private address must be listed in GTFS_WALK_VALHALLA_ALLOWED_HOSTS.
#GTFS_WALK_SNAP_ENABLED=true
#GTFS_WALK_VALHALLA_URL=http://atlas:8484
