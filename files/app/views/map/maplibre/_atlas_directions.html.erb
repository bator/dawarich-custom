<%# Directions tab through Atlas (docs/atlas.md): car, bike, walk (Valhalla)
    and public transport (MOTIS). The atlas-directions controller draws the
    route on the map; the button lives in the map-edge cluster. %>
<% scope = 'atlas_directions' %>
<div class="tab-content" data-tab-content="directions" data-map-panel-target="tabContent">
  <div data-controller="atlas-directions"
       data-atlas-directions-search-url-value="<%= search_api_v1_transit_directions_path %>"
       data-atlas-directions-route-url-value="<%= api_v1_transit_directions_path %>"
       data-atlas-directions-title-value="<%= t("#{scope}.title") %>"
       data-atlas-directions-labels-value="<%= {
         pick: t("#{scope}.pick"), need_points: t("#{scope}.need_points"), loading: t("#{scope}.loading"),
         no_route: t("#{scope}.no_route"), unavailable: t("#{scope}.unavailable"), rejected: t("#{scope}.rejected"),
         transfers: t("#{scope}.transfers"),
         walking: t("#{scope}.walking"), hour: t("#{scope}.hour"), minute: t("#{scope}.minute"),
         modes: t("#{scope}.legs").to_h
       }.to_json %>">
    <div class="join w-full mb-3" role="group" aria-label="<%= t("#{scope}.mode") %>">
      <% { 'car' => 'car', 'bike' => 'bike', 'walk' => 'footprints', 'transit' => 'bus' }.each do |mode, icon_name| %>
        <button type="button" class="btn btn-sm join-item flex-1" data-atlas-directions-target="mode" data-mode="<%= mode %>"
                data-action="atlas-directions#setMode" title="<%= t("#{scope}.modes.#{mode}") %>" aria-label="<%= t("#{scope}.modes.#{mode}") %>">
          <%= icon icon_name %>
        </button>
      <% end %>
    </div>

    <% %w[from to].each do |field| %>
      <div class="relative mb-2">
        <div class="join w-full">
          <input type="text" class="input input-bordered input-sm join-item w-full" autocomplete="off"
                 placeholder="<%= t("#{scope}.#{field}") %>" aria-label="<%= t("#{scope}.#{field}") %>"
                 data-atlas-directions-target="<%= field %>" data-field="<%= field %>"
                 data-action="input->atlas-directions#search">
          <button type="button" class="btn btn-sm join-item" data-field="<%= field %>" data-action="atlas-directions#pick"
                  title="<%= t("#{scope}.pick_button") %>" aria-label="<%= t("#{scope}.pick_button") %>">
            <%= icon 'map-pin' %>
          </button>
        </div>
        <div class="absolute z-50 w-full mt-1 bg-base-100 rounded-lg shadow-lg border border-base-300 hidden max-h-72 overflow-y-auto"
             data-atlas-directions-target="<%= field %>Results"></div>
      </div>
      <% if field == 'from' %>
        <div class="flex justify-center -my-1">
          <button type="button" class="btn btn-ghost btn-xs" data-action="atlas-directions#swap"
                  title="<%= t("#{scope}.swap") %>" aria-label="<%= t("#{scope}.swap") %>"><%= icon 'arrow-down-up' %></button>
        </div>
      <% end %>
    <% end %>

    <div class="hidden mb-2 space-y-1" data-atlas-directions-target="transitOptions">
      <input type="datetime-local" class="input input-bordered input-sm w-full" data-atlas-directions-target="time"
             data-action="input->atlas-directions#timeChanged" aria-label="<%= t("#{scope}.time") %>">
      <label class="label cursor-pointer justify-start gap-2 py-1">
        <input type="checkbox" class="checkbox checkbox-sm" data-atlas-directions-target="arriveBy">
        <span class="label-text text-sm"><%= t("#{scope}.arrive_by") %></span>
      </label>
    </div>

    <div class="flex gap-2 mb-2">
      <button type="button" class="btn btn-primary btn-sm flex-1" data-action="atlas-directions#route"><%= t("#{scope}.go") %></button>
      <button type="button" class="btn btn-ghost btn-sm" data-action="atlas-directions#clear"><%= t("#{scope}.clear") %></button>
    </div>
    <p class="text-sm mb-2" data-atlas-directions-target="status" role="status"></p>
    <div class="space-y-2" data-atlas-directions-target="results"></div>
    <p class="text-xs text-base-content/60 mt-3"><%= t("#{scope}.source") %></p>
  </div>
</div>
