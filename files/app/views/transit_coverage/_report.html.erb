<%#
  Lazy part of /transit/coverage (Turbo Frame): one card per user with the
  coverage share, a "typical day" (24 bars: height = average points in that
  hour, colour = share of days with data) and a bar per day of the period
  (height = points that day, colour = covered share of the day), so a fully
  covered user still shows a shape. Full i18n keys: this is a partial.
%>
<%
  meta = @report_meta
  dates = (meta.from..meta.to).to_a
  now = Time.current.in_time_zone(@zone)
  today_minutes = now.hour * 60 + now.min
  # colour of a day by its covered share
  tier = lambda do |share|
    if share.nil? || share <= 0 then 'bg-base-content/10'
    elsif share >= 0.9 then 'bg-success'
    elsif share >= 0.6 then 'bg-success/60'
    elsif share >= 0.25 then 'bg-warning'
    else 'bg-error'
    end
  end
  hm = ->(minutes) { format('%d:%02d', minutes / 60, minutes % 60) }
  stamp = ->(ts) { l(@zone.at(ts), format: '%m.%d %H:%M') }
  with_points, without = @users.partition { |user| @reports[user.id] }
%>
<%= turbo_frame_tag TransitCoverageController::FRAME do %>
  <% if with_points.empty? %>
    <p class="opacity-70 py-6"><%= t('transit_coverage.index.no_points', count: @days) %></p>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% with_points.each do |user| %>
        <%
          report = @reports[user.id]
          share = report.covered_minutes.fdiv([meta.total_minutes, 1].max)
          percent = (share * 100).round
          tone = if percent >= 90 then 'text-success-ink' elsif percent >= 60 then 'text-success-ink opacity-80' elsif percent >= 25 then 'text-warning-ink' else 'text-error-ink' end
          rhythm = meta.rhythm(report)
          silent_for = Time.current.to_i - report.last_ts
        %>
        <section class="card bg-base-200 shadow-sm" aria-labelledby="coverage-<%= user.id %>">
          <div class="card-body p-5 gap-4">
            <header class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h2 id="coverage-<%= user.id %>" class="font-semibold truncate" title="<%= user.email %>"><%= user.display_name %></h2>
                <p class="text-xs opacity-70 flex items-center gap-1.5">
                  <span class="inline-block w-2 h-2 rounded-full <%= silent_for <= 900 ? 'bg-success' : (silent_for <= 86_400 ? 'bg-warning' : 'bg-base-content/30') %>"></span>
                  <%= t('transit_coverage.index.last', time: time_ago_in_words(Time.zone.at(report.last_ts))) %>
                </p>
              </div>
              <div class="text-right shrink-0">
                <div class="text-3xl font-bold tabular-nums leading-none <%= tone %>"><%= percent %>%</div>
                <div class="text-[11px] opacity-70 mt-1"><%= t('transit_coverage.index.covered') %></div>
              </div>
            </header>

            <div>
              <div class="text-[11px] uppercase tracking-wide opacity-70 mb-1.5 cursor-help w-fit" title="<%= t('transit_coverage.index.typical_hint') %>"><%= t('transit_coverage.index.typical_day') %> ⓘ</div>
              <% max_mean = [rhythm.map { |r| r[:mean_points] }.max.to_f, 1].max %>
              <ol class="flex items-end gap-1 h-16" role="list">
                <% rhythm.each_with_index do |r, hour| %>
                  <li class="flex-1 h-full flex items-end"
                      title="<%= format('%02d:00–%02d:59', hour, hour) %>: <%= t('transit_coverage.index.hour_title', percent: (r[:share] * 100).round, points: r[:mean_points].round) %>">
                    <span class="w-full rounded-t <%= r[:share] >= 0.9 ? 'bg-primary' : (r[:share] >= 0.5 ? 'bg-primary/60' : (r[:share].positive? ? 'bg-primary/30' : 'bg-base-content/10')) %>"
                          style="height: <%= r[:share].positive? ? [(r[:mean_points] / max_mean * 100).round(1), 8].max : 4 %>%"></span>
                  </li>
                <% end %>
              </ol>
              <div class="flex justify-between text-[10px] opacity-70 tabular-nums mt-1"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
            </div>

            <div>
              <div class="flex justify-between text-[11px] opacity-70 mb-1.5">
                <span class="uppercase tracking-wide"><%= t('transit_coverage.index.days', count: dates.size) %></span>
                <span class="tabular-nums"><%= t('transit_coverage.index.days_label', covered: report.covered_days, total: dates.size) %></span>
              </div>
              <% max_points = [dates.map { |d| report.days[d]&.dig(:points).to_i }.max, 1].max %>
              <ol class="flex items-end gap-[3px] h-10" role="list">
                <% dates.each do |date| %>
                  <%
                    day = report.days[date]
                    possible = date == meta.to ? [today_minutes, 1].max : 1440
                    day_share = day && day[:minutes].fdiv(possible)
                  %>
                  <li class="flex-1 h-full flex items-end"
                      title="<%= l(date, format: '%Y-%m-%d') %>: <%= day ? "#{hm.call(day[:minutes])} · #{t('transit_coverage.index.points', count: day[:points])}" : t('transit_coverage.index.no_data') %>">
                    <span class="w-full rounded-[3px] <%= tier.call(day_share) %> <%= 'outline outline-1 outline-offset-1 outline-base-content/50' if date == meta.to %>"
                          style="height: <%= day ? [(day[:points] * 100.0 / max_points).round(1), 12].max : 12 %>%"></span>
                  </li>
                <% end %>
              </ol>
              <div class="flex justify-between text-[10px] opacity-70 tabular-nums mt-1">
                <span><%= l(meta.from, format: '%m.%d') %></span><span><%= t('transit_coverage.index.today') %></span>
              </div>
            </div>

            <% if report.gaps.any? %>
              <% longest = report.gaps.first %>
              <p class="text-xs opacity-70 border-t border-base-300 pt-3"
                 title="<%= report.gaps.map { |x, y| "#{stamp.call(x)} → #{stamp.call(y)} (#{transit_duration(y - x)})" }.join(' · ') %>">
                <%= t('transit_coverage.index.longest_gap', time: transit_duration(longest[1] - longest[0]), from: stamp.call(longest[0]), to: stamp.call(longest[1])) %>
              </p>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] opacity-70 mt-4">
    <span><%= t('transit_coverage.index.legend') %></span>
    <% [['bg-success', '≥ 90%'], ['bg-success/60', '60–90%'], ['bg-warning', '25–60%'], ['bg-error', '< 25%'], ['bg-base-content/10', t('transit_coverage.index.no_data')]].each do |cls, label| %>
      <span class="flex items-center gap-1"><span class="inline-block w-2.5 h-2.5 rounded-[3px] <%= cls %>"></span><%= label %></span>
    <% end %>
  </div>

  <% if without.any? %>
    <p class="text-sm opacity-70 mt-3">
      <%= t('transit_coverage.index.silent', count: @days) %> <%= without.map(&:display_name).sort_by(&:downcase).join(', ') %>
    </p>
  <% end %>

  <p class="text-xs opacity-70 mt-3">
    <%= t('transit_devices.index.updated', time: @cached_at.in_time_zone(@zone).strftime('%H:%M:%S'),
                                           minutes: (TransitCoverageController::CACHE_TTL / 60).to_i) %>
  </p>
<% end %>
