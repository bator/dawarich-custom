<%#
  Lazy part of /transit/coverage (Turbo Frame): per user a collapsed row
  that opens to thin 24-hour strips, one per day, newest first. Green spans:
  time with live points (Gtfs::CoverageReport::MERGE_S joins nearby points).
  Full i18n keys: this is a partial.
%>
<%
  dates = (@report_meta.from..@report_meta.to).to_a.reverse
  total_minutes = @report_meta.total_minutes
  now = Time.current.in_time_zone(@zone)
  now_pct = ((now.hour * 60 + now.min) / 1440.0 * 100).round(2)
  weekdays = t('transit_commute.index.weekdays')
  pct = ->(minute) { (minute / 1440.0 * 100).round(3) }
  hm = ->(minutes) { format('%d:%02d', minutes / 60, minutes % 60) }
  stamp = ->(ts) { l(@zone.at(ts), format: '%m.%d %H:%M') }
%>
<%= turbo_frame_tag TransitCoverageController::FRAME do %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs opacity-80 mb-3">
    <span class="flex items-center gap-1.5"><span class="inline-block w-4 h-2.5 rounded-sm bg-success"></span><%= t('transit_coverage.index.legend_tracked') %></span>
    <span class="flex items-center gap-1.5"><span class="inline-block w-4 h-2.5 rounded-sm bg-base-content/10"></span><%= t('transit_coverage.index.legend_gap') %></span>
    <span class="opacity-70"><%= t('transit_coverage.index.legend_rows') %></span>
  </div>

  <div class="flex flex-col gap-3">
    <% @users.each do |user| %>
      <% report = @reports[user.id] %>
      <% uptime = report ? (report.covered_minutes * 100.0 / [total_minutes, 1].max).round : 0 %>
      <details class="card bg-base-200 shadow-sm group">
        <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer p-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
          <span class="flex items-center gap-2 min-w-0">
            <svg class="h-4 w-4 opacity-50 transition-transform group-open:rotate-90 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
            <span class="font-semibold truncate" title="<%= user.email %>"><%= user.display_name %></span>
          </span>
          <% if report %>
            <span class="flex items-center gap-3 text-sm">
              <span class="hidden sm:block w-28 h-1.5 rounded-full bg-base-100 overflow-hidden">
                <span class="block h-full <%= uptime >= 60 ? 'bg-success' : (uptime >= 25 ? 'bg-warning' : 'bg-error') %>" style="width: <%= uptime.clamp(0, 100) %>%"></span>
              </span>
              <strong class="tabular-nums"><%= uptime %>%</strong>
              <span class="opacity-60 tabular-nums"><%= t('transit_coverage.index.days_label', covered: report.covered_days, total: dates.size) %></span>
              <span class="opacity-60 hidden md:inline"><%= t('transit_coverage.index.last', time: time_ago_in_words(Time.zone.at(report.last_ts))) %></span>
            </span>
          <% else %>
            <span class="text-sm opacity-60"><%= t('transit_coverage.index.no_points', count: @days) %></span>
          <% end %>
        </summary>

        <% if report %>
          <div class="px-4 pb-4">
            <div class="grid grid-cols-[2.75rem_1fr] gap-x-2 text-[10px] opacity-50 tabular-nums mb-0.5">
              <span></span>
              <span class="relative h-3">
                <% [0, 6, 12, 18, 24].each do |h| %>
                  <span class="absolute -translate-x-1/2 <%= 'translate-x-0' if h.zero? %> <%= '-translate-x-full' if h == 24 %>" style="left: <%= (h / 24.0 * 100).round(2) %>%"><%= format('%02d', h) %></span>
                <% end %>
              </span>
            </div>
            <div class="flex flex-col gap-0.5">
              <% dates.each do |date| %>
                <% day = report.days[date] %>
                <% today = date == @report_meta.to %>
                <div class="grid grid-cols-[2.75rem_1fr] gap-x-2 items-center h-1.5"
                     title="<%= weekdays[date.cwday - 1] %> <%= l(date, format: '%Y-%m-%d') %>: <%= day ? hm.call(day[:minutes]) : '0:00' %>, <%= t('transit_coverage.index.points', count: day ? day[:points] : 0) %>">
                  <span class="text-[9px] leading-none tabular-nums opacity-60 whitespace-nowrap">
                    <%= l(date, format: '%m.%d') if today || date.cwday == 1 %>
                  </span>
                  <span class="relative h-1.5 rounded-sm overflow-hidden bg-base-content/10"
                        style="<%= "clip-path: inset(0 #{(100 - now_pct).round(2)}% 0 0)" if today %>">
                    <% day&.dig(:spans)&.each do |from_min, to_min| %>
                      <span class="absolute inset-y-0 bg-success" style="left: <%= pct.call(from_min) %>%; width: <%= [pct.call(to_min) - pct.call(from_min), 0.2].max %>%"></span>
                    <% end %>
                    <% [6, 12, 18].each do |h| %>
                      <span class="absolute inset-y-0 w-px bg-base-200" style="left: <%= (h / 24.0 * 100).round(2) %>%"></span>
                    <% end %>
                  </span>
                </div>
              <% end %>
            </div>

            <% if report.gaps.any? %>
              <% longest = report.gaps.first %>
              <p class="text-xs opacity-70 mt-3"
                 title="<%= report.gaps.map { |x, y| "#{stamp.call(x)} → #{stamp.call(y)} (#{transit_duration(y - x)})" }.join(' · ') %>">
                <%= t('transit_coverage.index.longest_gap', time: transit_duration(longest[1] - longest[0]), from: stamp.call(longest[0]), to: stamp.call(longest[1])) %>
                <% if report.gaps.size > 1 %><span class="opacity-60">· <%= t('transit_coverage.index.more_gaps', count: report.gaps.size - 1) %></span><% end %>
              </p>
            <% end %>
          </div>
        <% end %>
      </details>
    <% end %>
  </div>

  <p class="text-xs opacity-50 mt-4">
    <%= t('transit_devices.index.updated', time: @cached_at.in_time_zone(@zone).strftime('%H:%M:%S'),
                                           minutes: (TransitCoverageController::CACHE_TTL / 60).to_i) %>
  </p>
<% end %>
