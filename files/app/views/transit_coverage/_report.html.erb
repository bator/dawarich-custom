<%#
  Lazy part of /transit/coverage (Turbo Frame): one card per user with a
  calendar heatmap (weeks as columns, Monday on top) of covered hours per day
  and the longest gaps. Full i18n keys: this is a partial.
%>
<%
  from = @report_meta.from
  to = @report_meta.to
  total = @report_meta.total_days
  start = from.beginning_of_week
  weeks = ((to - start).to_i / 7) + 1
  weekdays = t('transit_commute.index.weekdays')
  shade = lambda do |hours|
    if hours.nil? || hours.zero? then 'bg-base-content/10'
    elsif hours <= 6 then 'bg-success/30'
    elsif hours <= 14 then 'bg-success/60'
    else 'bg-success'
    end
  end
  stamp = ->(ts) { l(@zone.at(ts), format: '%m.%d %H:%M') }
%>
<%= turbo_frame_tag TransitCoverageController::FRAME do %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs opacity-80 mb-4">
    <span><%= t('transit_coverage.index.legend') %></span>
    <% [[0, 'bg-base-content/10'], ['1–6', 'bg-success/30'], ['7–14', 'bg-success/60'], ['15–24', 'bg-success']].each do |label, cls| %>
      <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-sm <%= cls %>"></span><%= label %></span>
    <% end %>
  </div>

  <div class="flex flex-col gap-4">
    <% @users.each do |user| %>
      <% report = @reports[user.id] %>
      <section class="card bg-base-200 shadow-sm" aria-labelledby="coverage-<%= user.id %>">
        <div class="card-body p-4 gap-3">
          <header class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="coverage-<%= user.id %>" class="font-semibold text-lg" title="<%= user.email %>"><%= user.display_name %></h2>
            <% if report %>
              <span class="text-sm opacity-80">
                <%= t('transit_coverage.index.summary', covered: report.covered_days, total:, hours: number_with_precision(report.mean_hours(total), precision: 1)) %>
                · <%= t('transit_coverage.index.last', time: time_ago_in_words(Time.zone.at(report.last_ts))) %>
              </span>
            <% end %>
          </header>

          <% if report.nil? %>
            <p class="text-sm opacity-70"><%= t('transit_coverage.index.no_points', count: @days) %></p>
          <% else %>
            <div class="flex gap-1 overflow-x-auto pb-1">
              <div class="grid grid-rows-7 gap-1 text-[10px] opacity-50 pr-1">
                <% weekdays.each do |d| %><span class="h-4 leading-4"><%= d %></span><% end %>
              </div>
              <% weeks.times do |w| %>
                <div class="grid grid-rows-7 gap-1">
                  <% 7.times do |d| %>
                    <% date = start + (w * 7) + d %>
                    <% if date < from || date > to %>
                      <span class="w-4 h-4"></span>
                    <% else %>
                      <% hours, points = report.days[date] %>
                      <span class="w-4 h-4 rounded-sm <%= shade.call(hours) %> <%= 'ring-1 ring-primary' if date == to %>"
                            title="<%= l(date, format: '%Y-%m-%d') %>: <%= t('transit_coverage.index.cell', hours: hours.to_i, points: points.to_i) %>"></span>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>

            <% if report.gaps.any? %>
              <div>
                <div class="text-[11px] uppercase tracking-wide opacity-60 mb-1"><%= t('transit_coverage.index.gaps', hours: Gtfs::CoverageReport::GAP_S / 3600) %></div>
                <ul class="flex flex-wrap gap-2" role="list">
                  <% report.gaps.each do |a, b| %>
                    <li class="badge badge-outline gap-1 tabular-nums"><%= stamp.call(a) %> → <%= stamp.call(b) %> <span class="opacity-60">(<%= transit_duration(b - a) %>)</span></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <p class="text-xs opacity-50 mt-4">
    <%= t('transit_devices.index.updated', time: @cached_at.in_time_zone(@zone).strftime('%H:%M:%S'),
                                           minutes: (TransitCoverageController::CACHE_TTL / 60).to_i) %>
  </p>
<% end %>
