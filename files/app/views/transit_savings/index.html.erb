<% content_for :title, t('.title') %>
<%
  s = @savings
  kg = ->(value) { value.abs >= 100 ? number_with_precision(value, precision: 0, delimiter: ' ') : number_with_precision(value, precision: 1) }
  ft = ->(value) { "#{number_with_precision(value, precision: 0, delimiter: ' ')} Ft" }
%>

<div class="min-h-content w-full my-5 max-w-4xl mx-auto px-2">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'shared/transit_tabs', active: :savings, days: @days %>
  <%= render 'shared/transit_period_form', path: transit_savings_path, periods: TransitSavingsController::PERIODS,
                                           note: t('transit_savings.index.note') %>

  <% if s.rides_count.zero? %>
    <p class="opacity-70 py-6"><%= t('transit_segments.index.empty') %></p>
  <% else %>
    <%
      max_kg = [s.car_kg, s.transit_kg, 0.001].max
      series = s.cumulative
      last = series.last
      y_max = [last[1], last[2], last[3], 1].max * 1.08
      w = 600.0
      h = 200.0
      left = 52.0
      bottom = 22.0
      top = 8.0
      x_at = ->(i) { left + (w - left - 8) * (series.size <= 1 ? 0 : i.fdiv(series.size - 1)) }
      y_at = ->(v) { top + (h - top - bottom) * (1 - v / y_max) }
      line = ->(col) { series.each_with_index.map { |row, i| "#{x_at.call(i).round(1)},#{y_at.call(row[col]).round(1)}" }.join(' ') }
      step = lambda do
        pts = []
        series.each_with_index do |row, i|
          pts << [x_at.call(i), y_at.call(series[i - 1][3])] if i.positive? && row[3] != series[i - 1][3]
          pts << [x_at.call(i), y_at.call(row[3])]
        end
        pts.map { |x, y| "#{x.round(1)},#{y.round(1)}" }.join(' ')
      end
      ticks = 4.times.map { |i| y_max / 4 * (i + 1) }
      k = ->(v) { v >= 1000 ? "#{(v / 1000).round(v >= 10_000 ? 0 : 1)}k" : v.round.to_s }
      pace = s.rides_per_pass_period
    %>
    <section class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">
      <div class="md:col-span-3 rounded-box bg-success/10 border border-success/30 p-5 flex flex-col gap-4">
        <div class="flex items-start gap-4">
          <%= transit_icon('trees', 'w-12 h-12 text-success-ink') %>
          <div>
            <div class="text-xs uppercase tracking-wide text-success-ink"><%= t('.co2_saved') %></div>
            <div class="text-4xl font-bold tabular-nums leading-tight"><%= kg.call(s.saved_kg) %> kg CO₂</div>
            <div class="text-sm opacity-80 mt-1">
              <%= t('.trees', count: s.trees.round(1)) %> · <%= t('.car_km', km: number_with_precision(s.car_km_equivalent, precision: 0, delimiter: ' ')) %>
            </div>
          </div>
        </div>
        <div class="flex flex-col gap-2 text-sm">
          <div class="grid grid-cols-[4.5rem_1fr_4.5rem] items-center gap-2">
            <span class="opacity-80"><%= t('.you') %></span>
            <span class="h-3 rounded-full bg-base-100 overflow-hidden"><span class="block h-full bg-success rounded-full" style="width: <%= (s.transit_kg / max_kg * 100).clamp(1, 100).round(1) %>%"></span></span>
            <span class="text-right tabular-nums"><%= kg.call(s.transit_kg) %> kg</span>
          </div>
          <div class="grid grid-cols-[4.5rem_1fr_4.5rem] items-center gap-2">
            <span class="opacity-80"><%= t('.car') %></span>
            <span class="h-3 rounded-full bg-base-100 overflow-hidden"><span class="block h-full bg-base-content/40 rounded-full" style="width: <%= (s.car_kg / max_kg * 100).clamp(1, 100).round(1) %>%"></span></span>
            <span class="text-right tabular-nums"><%= kg.call(s.car_kg) %> kg</span>
          </div>
          <p class="text-xs opacity-70"><%= t('.km_rides', km: number_with_precision(s.km, precision: 0, delimiter: ' '), count: s.rides_count) %></p>
        </div>
      </div>
      <div class="md:col-span-2 rounded-box bg-base-200 p-5 flex flex-col gap-3">
        <div class="text-xs uppercase tracking-wide opacity-70"><%= t(s.saved_ft.positive? ? '.money_saved' : '.money_more') %></div>
        <div class="text-4xl font-bold tabular-nums leading-tight <%= s.saved_ft.positive? ? 'text-primary-ink' : 'text-warning-ink' %>"><%= ft.call(s.saved_ft.abs) %></div>
        <div class="text-sm opacity-80"><%= t('.money_detail', car: ft.call(s.car_cost_ft), transit: ft.call(s.transit_cost_ft), option: t(s.cheaper_option == :pass ? '.option_pass' : '.option_tickets')) %></div>
        <div class="mt-auto rounded-box bg-base-100 p-3 text-sm">
          <div class="font-medium"><%= t('.break_even', count: s.break_even_rides, days: Gtfs::SavingsEstimate::PASS_DAYS) %></div>
          <div class="text-xs opacity-70 mt-0.5"><%= t('.your_pace', count: pace.round(1)) %> → <%= t(pace >= s.break_even_rides ? '.pace_pass' : '.pace_tickets') %></div>
        </div>
      </div>
    </section>

    <section class="card bg-base-200 shadow-sm mb-6" aria-labelledby="savings-cumulative">
      <div class="card-body p-5 gap-3">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="savings-cumulative" class="font-semibold"><%= t('.cumulative') %></h2>
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs" role="list">
            <li class="flex items-center gap-1.5"><span class="inline-block w-4 h-0.5 bg-base-content/50"></span><%= t('.series_car') %> <span class="opacity-70 tabular-nums"><%= ft.call(last[1]) %></span></li>
            <li class="flex items-center gap-1.5"><span class="inline-block w-4 h-0.5 bg-warning"></span><%= t('.series_tickets') %> <span class="opacity-70 tabular-nums"><%= ft.call(last[2]) %></span></li>
            <li class="flex items-center gap-1.5"><span class="inline-block w-4 h-0.5 bg-primary"></span><%= t('.series_pass') %> <span class="opacity-70 tabular-nums"><%= ft.call(last[3]) %></span></li>
          </ul>
        </div>
        <svg viewBox="0 0 <%= w.to_i %> <%= h.to_i %>" class="w-full h-auto" role="img" aria-label="<%= t('.cumulative') %>">
          <% ticks.each do |v| %>
            <line x1="<%= left %>" x2="<%= w - 8 %>" y1="<%= y_at.call(v).round(1) %>" y2="<%= y_at.call(v).round(1) %>" class="stroke-base-content/10" stroke-width="1" />
            <text x="<%= left - 6 %>" y="<%= (y_at.call(v) + 3).round(1) %>" text-anchor="end" class="fill-base-content/50" font-size="10"><%= k.call(v) %></text>
          <% end %>
          <line x1="<%= left %>" x2="<%= w - 8 %>" y1="<%= h - bottom %>" y2="<%= h - bottom %>" class="stroke-base-content/20" stroke-width="1" />
          <polyline points="<%= line.call(1) %>" fill="none" class="stroke-base-content/50" stroke-width="2" stroke-linejoin="round" />
          <polyline points="<%= line.call(2) %>" fill="none" class="stroke-warning" stroke-width="2.5" stroke-linejoin="round" />
          <polyline points="<%= step.call %>" fill="none" class="stroke-primary" stroke-width="2.5" stroke-linejoin="round" />
          <text x="<%= left %>" y="<%= h - 6 %>" class="fill-base-content/50" font-size="10"><%= l(series.first[0], format: '%m.%d') %></text>
          <text x="<%= w - 8 %>" y="<%= h - 6 %>" text-anchor="end" class="fill-base-content/50" font-size="10"><%= t('transit_coverage.index.today') %></text>
        </svg>
      </div>
    </section>

    <%
      p = @punctuality
      colors = { early: 'bg-info', on_time: 'bg-success', slight: 'bg-warning', late: 'bg-error' }
      pct = ->(share) { share.nil? ? '–' : "#{(share * 100).round}%" }
      cat_title = ->(shares) { Gtfs::PunctualityStats::CATEGORIES.map { |c| "#{t(".punctuality.cat_#{c}")} #{pct.call(shares[c])}" }.join(' · ') }
      stacked = lambda do |shares|
        safe_join(Gtfs::PunctualityStats::CATEGORIES.reject { |c| shares[c].zero? }.map do |c|
          tag.span(class: "h-full #{colors[c]}", style: "width: #{(shares[c] * 100).round(2)}%")
        end)
      end
    %>
    <section id="punctuality" class="card bg-base-200 shadow-sm mb-6 scroll-mt-20" aria-labelledby="savings-punctuality">
      <div class="card-body p-5 gap-4">
        <h2 id="savings-punctuality" class="font-semibold"><%= t('.punctuality.title') %></h2>
        <% if p.measured.empty? %>
          <p class="text-sm opacity-70"><%= t('.punctuality.empty', count: @days) %></p>
        <% else %>
          <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3">
            <div>
              <dt class="text-xs uppercase tracking-wide text-success-ink"><%= t('.punctuality.within_5') %></dt>
              <dd class="text-3xl font-bold tabular-nums leading-tight"><%= pct.call(p.within_5) %></dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide opacity-70"><%= t('.punctuality.within_1') %></dt>
              <dd class="text-3xl font-bold tabular-nums leading-tight"><%= pct.call(p.within_1) %></dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide opacity-70"><%= t('.punctuality.median') %></dt>
              <dd class="text-3xl font-bold tabular-nums leading-tight"><%= transit_delay(p.median_s) %></dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide opacity-70"><%= t('.punctuality.measured') %></dt>
              <dd class="text-3xl font-bold tabular-nums leading-tight"><%= p.measured.size %>
                <span class="text-sm font-normal opacity-70"><%= t('.punctuality.of_rides', count: @period_stats.count) %></span></dd>
            </div>
          </dl>

          <div class="flex flex-col gap-1.5">
            <span class="flex h-3 rounded-full overflow-hidden bg-base-100" title="<%= cat_title.call(p.shares) %>"><%= stacked.call(p.shares) %></span>
            <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs" role="list">
              <% Gtfs::PunctualityStats::CATEGORIES.each do |cat| %>
                <li class="flex items-center gap-1.5">
                  <span class="inline-block w-2.5 h-2.5 rounded-sm <%= colors[cat] %>"></span>
                  <%= t(".punctuality.cat_#{cat}") %> <span class="opacity-70 tabular-nums"><%= pct.call(p.shares[cat]) %></span>
                </li>
              <% end %>
            </ul>
          </div>

          <div class="flex flex-col gap-3 border-t border-base-300 pt-4">
            <h3 class="text-xs uppercase tracking-wide opacity-70"><%= t('.punctuality.per_line', min: Gtfs::PunctualityStats::MIN_RIDES) %></h3>
            <% if p.lines.empty? %>
              <p class="text-sm opacity-70"><%= t('.punctuality.no_lines', min: Gtfs::PunctualityStats::MIN_RIDES) %></p>
            <% else %>
              <ul class="flex flex-col gap-3" role="list">
                <% p.lines.each do |line| %>
                  <li class="grid grid-cols-[6.5rem_1fr_3.5rem] items-center gap-3">
                    <span class="flex items-center gap-1"><%= transit_line_badge(line.segment, @colors) %><span class="text-xs opacity-70 tabular-nums">×<%= line.count %></span></span>
                    <span class="flex h-3 rounded-full overflow-hidden bg-base-100"
                          title="<%= cat_title.call(line.shares) %> · <%= t('.punctuality.median') %> <%= transit_delay(line.median_s) %>"><%= stacked.call(line.shares) %></span>
                    <span class="text-right">
                      <span class="font-semibold tabular-nums"><%= pct.call(line.within_5) %></span>
                      <span class="block text-[10px] opacity-70 tabular-nums"><%= transit_delay(line.median_s) %></span>
                    </span>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
        <p class="text-xs opacity-70"><%= t('.punctuality.lines_legend') unless p.lines.empty? %> <%= t('.punctuality.note') %></p>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      <section class="card bg-base-200 shadow-sm" aria-labelledby="savings-modes">
        <div class="card-body p-5 gap-2">
          <h2 id="savings-modes" class="font-semibold"><%= t('.by_mode') %></h2>
          <% max_mode = [s.by_mode.map { |_, _, _, car| car }.max.to_f, 0.001].max %>
          <ul class="flex flex-col gap-2" role="list">
            <% s.by_mode.each do |mode, km, transit_kg, car_kg| %>
              <li class="text-sm">
                <div class="flex justify-between"><span class="flex items-center gap-1.5"><%= transit_mode_icon(mode) %><%= t("transit_modes.#{mode}") %></span><span class="tabular-nums opacity-70"><%= number_with_precision(km, precision: 0, delimiter: ' ') %> km</span></div>
                <div class="relative h-2 rounded-full bg-base-100 mt-1" title="<%= kg.call(transit_kg) %> kg / <%= kg.call(car_kg) %> kg">
                  <span class="absolute inset-y-0 left-0 rounded-full bg-base-content/25" style="width: <%= (car_kg / max_mode * 100).round(1) %>%"></span>
                  <span class="absolute inset-y-0 left-0 rounded-full bg-success" style="width: <%= (transit_kg / max_mode * 100).clamp(0.5, 100).round(1) %>%"></span>
                </div>
              </li>
            <% end %>
          </ul>
          <p class="text-xs opacity-70"><%= t('.by_mode_legend') %></p>
        </div>
      </section>
      <section class="card bg-base-200 shadow-sm" aria-labelledby="savings-months">
        <div class="card-body p-5 gap-2">
          <h2 id="savings-months" class="font-semibold"><%= t('.by_month') %></h2>
          <% months = s.by_month %>
          <% max_month = [months.map { |_, saved, _| saved }.max.to_f, 0.001].max %>
          <ol class="flex items-end gap-2 h-28" role="list">
            <% months.each do |month, saved, km| %>
              <li class="flex-1 h-full flex flex-col justify-end items-center gap-1" title="<%= l(month, format: '%Y-%m') %>: <%= kg.call(saved) %> kg, <%= number_with_precision(km, precision: 0) %> km">
                <span class="text-[10px] tabular-nums opacity-70"><%= kg.call(saved) %></span>
                <span class="w-full max-w-10 rounded-t bg-success" style="height: <%= (saved.clamp(0, Float::INFINITY) / max_month * 100).clamp(3, 100).round(1) %>%"></span>
                <span class="text-[10px] opacity-70 tabular-nums"><%= l(month, format: '%m') %></span>
              </li>
            <% end %>
          </ol>
          <p class="text-xs opacity-70"><%= t('.by_month_legend') %></p>
        </div>
      </section>
    </div>
  <% end %>

  <details class="card bg-base-200 shadow-sm">
    <summary class="card-body p-4 cursor-pointer font-semibold list-none [&::-webkit-details-marker]:hidden"><%= t('.assumptions') %> ▾</summary>
    <div class="px-4 pb-4 text-sm flex flex-col gap-2">
      <p class="opacity-70"><%= t('.assumptions_intro') %></p>
      <table class="table table-xs">
        <tbody>
          <tr><td><%= t('.a_car_co2') %></td><td class="tabular-nums"><%= s.car_g_km.round %> g/km</td><td class="text-xs opacity-70">TRANSIT_CO2_CAR_G_KM</td></tr>
          <% Gtfs::SavingsEstimate::DEFAULT_CO2_G_PKM.each_key do |mode| %>
            <tr><td><span class="flex items-center gap-1.5"><%= transit_mode_icon(mode, 'w-3.5 h-3.5') %><%= t("transit_modes.#{mode}") %></span></td><td class="tabular-nums"><%= s.co2_g_pkm(mode).round %> g/<%= t('.pkm') %></td><td class="text-xs opacity-70">TRANSIT_CO2_<%= mode.upcase %>_G_PKM</td></tr>
          <% end %>
          <tr><td><%= t('.a_car_cost') %></td><td class="tabular-nums"><%= ft.call(s.car_ft_km) %>/km</td><td class="text-xs opacity-70">TRANSIT_CAR_FT_KM</td></tr>
          <tr><td><%= t('.a_ticket') %></td><td class="tabular-nums"><%= ft.call(s.ticket_ft) %></td><td class="text-xs opacity-70">TRANSIT_TICKET_FT</td></tr>
          <tr><td><%= t('.a_pass', days: Gtfs::SavingsEstimate::PASS_DAYS) %></td><td class="tabular-nums"><%= ft.call(s.pass_ft) %></td><td class="text-xs opacity-70">TRANSIT_PASS_FT</td></tr>
          <tr><td><%= t('.a_tree') %></td><td class="tabular-nums"><%= s.tree_kg_year.round %> kg/<%= t('.year') %></td><td class="text-xs opacity-70">TRANSIT_TREE_KG_YEAR</td></tr>
        </tbody>
      </table>
    </div>
  </details>
</div>
