<% content_for :title, t('.title') %>
<%
  p = @punctuality
  colors = { early: 'bg-info', on_time: 'bg-success', slight: 'bg-warning', late: 'bg-error' }
  pct = ->(share) { share.nil? ? '–' : "#{(share * 100).round}%" }
  hist = p.histogram
  max_bin = [hist.map { |_, n, _| n }.max.to_i, 1].max
%>

<div class="min-h-content w-full my-5 max-w-4xl mx-auto px-2">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'shared/transit_tabs', active: :punctuality, days: @days %>
  <%= render 'shared/transit_period_form', path: transit_punctuality_path, periods: TransitPunctualityController::PERIODS,
                                           note: t('transit_punctuality.index.note') %>

  <% if p.measured.empty? %>
    <p class="opacity-70 py-6"><%= t('.empty', count: @days) %></p>
  <% else %>
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6" aria-label="<%= t('.summary') %>">
      <div class="rounded-box bg-success/10 border border-success/30 p-4">
        <div class="text-xs uppercase tracking-wide text-success"><%= t('.within_5') %></div>
        <div class="text-3xl font-bold tabular-nums mt-1"><%= pct.call(p.within_5) %></div>
      </div>
      <div class="rounded-box bg-base-200 p-4">
        <div class="text-xs uppercase tracking-wide opacity-60"><%= t('.within_1') %></div>
        <div class="text-3xl font-bold tabular-nums mt-1"><%= pct.call(p.within_1) %></div>
      </div>
      <div class="rounded-box bg-base-200 p-4">
        <div class="text-xs uppercase tracking-wide opacity-60"><%= t('.median') %></div>
        <div class="text-3xl font-bold tabular-nums mt-1"><%= transit_delay(p.median_s) %></div>
      </div>
      <div class="rounded-box bg-base-200 p-4">
        <div class="text-xs uppercase tracking-wide opacity-60"><%= t('.measured') %></div>
        <div class="text-3xl font-bold tabular-nums mt-1"><%= p.measured.size %></div>
        <div class="text-xs opacity-60"><%= t('.of_rides', count: @period_stats.count) %></div>
      </div>
    </section>

    <section class="card bg-base-200 shadow-sm mb-6" aria-labelledby="punct-hist">
      <div class="card-body p-5 gap-3">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="punct-hist" class="font-semibold"><%= t('.distribution') %></h2>
          <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs" role="list">
            <% Gtfs::PunctualityStats::CATEGORIES.each do |cat| %>
              <li class="flex items-center gap-1.5">
                <span class="inline-block w-2.5 h-2.5 rounded-sm <%= colors[cat] %>"></span>
                <%= t(".cat_#{cat}") %> <span class="opacity-60 tabular-nums"><%= pct.call(p.shares[cat]) %></span>
              </li>
            <% end %>
          </ul>
        </div>
        <ol class="flex items-end gap-1 h-32" role="list">
          <% hist.each do |minute, count, cat| %>
            <% label = if minute == Gtfs::PunctualityStats::HIST_FROM then "≤ #{minute}" elsif minute == Gtfs::PunctualityStats::HIST_TO then "#{minute}+" else (minute.positive? ? "+#{minute}" : minute.to_s) end %>
            <li class="flex-1 h-full flex flex-col justify-end items-center gap-0.5" title="<%= label %> min: <%= count %>">
              <% if count.positive? %><span class="text-[10px] tabular-nums opacity-60"><%= count %></span><% end %>
              <span class="w-full rounded-t <%= count.zero? ? 'bg-base-content/10' : colors[cat] %>"
                    style="height: <%= count.zero? ? 3 : (count * 100.0 / max_bin).round(1) %>%"></span>
            </li>
          <% end %>
        </ol>
        <div class="flex gap-1 text-[10px] opacity-50 tabular-nums -mt-1">
          <% hist.each do |minute, _, _| %>
            <span class="flex-1 text-center"><%= if minute == Gtfs::PunctualityStats::HIST_FROM then "≤#{minute}" elsif minute == Gtfs::PunctualityStats::HIST_TO then "#{minute}+" elsif (minute % 3).zero? then (minute.positive? ? "+#{minute}" : minute.to_s) end %></span>
          <% end %>
        </div>
        <p class="text-xs opacity-60 text-center"><%= t('.minutes_axis') %></p>
      </div>
    </section>

    <section class="card bg-base-200 shadow-sm" aria-labelledby="punct-lines">
      <div class="card-body p-5 gap-3">
        <h2 id="punct-lines" class="font-semibold"><%= t('.per_line', min: Gtfs::PunctualityStats::MIN_RIDES) %></h2>
        <% if p.lines.empty? %>
          <p class="text-sm opacity-70"><%= t('.no_lines', min: Gtfs::PunctualityStats::MIN_RIDES) %></p>
        <% else %>
          <ul class="flex flex-col gap-3" role="list">
            <% p.lines.each do |line| %>
              <% shares = line.shares %>
              <li class="grid grid-cols-[6.5rem_1fr_3.5rem] items-center gap-3">
                <span class="flex items-center gap-1"><%= transit_line_badge(line.segment, @colors) %><span class="text-xs opacity-60 tabular-nums">×<%= line.count %></span></span>
                <span class="flex h-3 rounded-full overflow-hidden bg-base-100"
                      title="<%= Gtfs::PunctualityStats::CATEGORIES.map { |c| "#{t(".cat_#{c}")} #{pct.call(shares[c])}" }.join(' · ') %> · <%= t('.median') %> <%= transit_delay(line.median_s) %>">
                  <% Gtfs::PunctualityStats::CATEGORIES.each do |cat| %>
                    <% next if shares[cat].zero? %>
                    <span class="h-full <%= colors[cat] %>" style="width: <%= (shares[cat] * 100).round(2) %>%"></span>
                  <% end %>
                </span>
                <span class="text-right">
                  <span class="font-semibold tabular-nums"><%= pct.call(line.within_5) %></span>
                  <span class="block text-[10px] opacity-60 tabular-nums"><%= transit_delay(line.median_s) %></span>
                </span>
              </li>
            <% end %>
          </ul>
          <p class="text-xs opacity-60"><%= t('.lines_legend') %></p>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
