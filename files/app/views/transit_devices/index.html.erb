<% content_for :title, t('.title') %>

<div class="min-h-content w-full my-5 max-w-4xl mx-auto px-2">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'shared/transit_tabs', active: :devices %>

  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <%= form_with url: transit_devices_path, method: :get, local: true, class: 'flex flex-wrap items-end gap-3' do %>
      <label class="form-control">
        <span class="label-text"><%= t('transit_devices.index.period') %></span>
        <%= select_tag :days, options_for_select(TransitDevicesController::PERIODS.map { |d| [t('transit_devices.index.days', count: d), d] }, @days),
                       class: 'select select-bordered select-sm min-h-11' %>
      </label>
      <%= submit_tag t('transit_devices.index.filter'), class: 'btn btn-primary btn-sm min-h-11', name: nil %>
    <% end %>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs opacity-80" aria-label="<%= t('transit_devices.index.legend') %>">
      <li class="flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-success"></span><%= t('transit_devices.index.legend_fresh', minutes: (TransitDevicesController::FRESH / 60).to_i) %></li>
      <li class="flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-warning"></span><%= t('transit_devices.index.legend_today') %></li>
      <li class="flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-base-content/30"></span><%= t('transit_devices.index.legend_stale') %></li>
    </ul>
  </div>

  <%= turbo_frame_tag TransitDevicesController::FRAME, src: transit_devices_path(days: @days), loading: :lazy do %>
    <div class="flex items-center gap-3 py-10 justify-center opacity-70" role="status">
      <span class="loading loading-spinner loading-md"></span>
      <span><%= t('transit_devices.index.loading') %></span>
    </div>
  <% end %>
</div>
