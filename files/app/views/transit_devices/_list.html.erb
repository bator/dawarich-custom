<%#
  The lazy part of /transit/devices (Turbo Frame). One card per person with
  live reports, newest first; people without any report in the period are
  listed together at the end. Full i18n keys: this is a partial.
%>
<%
  now = Time.current
  today = @zone.today
  dot = lambda do |timestamp|
    age = now - Time.zone.at(timestamp.to_i)
    if age <= TransitDevicesController::FRESH then 'bg-success'
    elsif age <= TransitDevicesController::STALE then 'bg-warning'
    else 'bg-base-content/30'
    end
  end
  ago = ->(timestamp) { t('transit_devices.index.ago', time: time_ago_in_words(Time.zone.at(timestamp.to_i))) }
  clock = lambda do |timestamp|
    time = @zone.at(timestamp.to_i)
    time.to_date == today ? time.strftime('%H:%M') : l(time, format: '%Y-%m-%d %H:%M')
  end
%>
<%= turbo_frame_tag TransitDevicesController::FRAME do %>
  <% if @people.empty? %>
    <p class="opacity-70 py-6"><%= t('transit_devices.index.no_reports', count: @days) %></p>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @people.each do |user, devices| %>
        <% newest = devices.first %>
        <section class="card bg-base-200 shadow" aria-labelledby="person-<%= user.id %>">
          <div class="card-body p-4 gap-1">
            <header class="flex items-center justify-between gap-2 mb-1">
              <h2 id="person-<%= user.id %>" class="font-semibold text-lg truncate" title="<%= user.email %>"><%= user.display_name %></h2>
              <span class="flex items-center gap-1.5 text-sm whitespace-nowrap">
                <span class="inline-block w-2.5 h-2.5 rounded-full <%= dot.call(newest['timestamp']) %>" aria-hidden="true"></span>
                <%= ago.call(newest['timestamp']) %>
              </span>
            </header>
            <ul class="flex flex-col divide-y divide-base-300" role="list">
              <% devices.each do |row| %>
                <%
                  battery = row['battery'].to_i if row['battery'].present? && row['battery'].to_i >= 0
                  place = row['city'].presence || row['country_name'].presence
                  delay = row['received_at'].to_i - row['timestamp'].to_i
                  name = row['tracker_id'].presence || t('transit_devices.index.unknown_device')
                %>
                <li class="flex items-start gap-3 py-2" title="<%= [row['topic'], t('transit_devices.index.points_title', count: row['points_count'].to_i, days: @days)].compact_blank.join(' · ') %>">
                  <span class="mt-1.5 inline-block w-2.5 h-2.5 rounded-full shrink-0 <%= dot.call(row['timestamp']) %>" aria-hidden="true"></span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class="font-medium truncate"><%= name %></span>
                      <span class="text-sm whitespace-nowrap"><%= ago.call(row['timestamp']) %></span>
                    </div>
                    <div class="text-xs opacity-70 flex flex-wrap gap-x-2">
                      <span class="tabular-nums"><%= clock.call(row['timestamp']) %></span>
                      <% if battery %>
                        <span class="<%= 'text-error opacity-100' if battery < 20 %>">🔋 <%= battery %>%</span>
                      <% end %>
                      <% if place %><span class="truncate">📍 <%= place %></span><% end %>
                      <% if delay > 300 %>
                        <span><%= t('transit_devices.index.late', time: distance_of_time_in_words(delay)) %></span>
                      <% end %>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>

  <% if @silent.any? %>
    <p class="text-sm opacity-70 mt-4">
      <%= t('transit_devices.index.silent', count: @days) %>
      <%= @silent.map { |user, _| user.display_name }.sort_by(&:downcase).join(', ') %>
    </p>
  <% end %>

  <p class="text-xs opacity-50 mt-4">
    <%= t('transit_devices.index.updated', time: @cached_at.in_time_zone(@zone).strftime('%H:%M:%S'),
                                           minutes: (TransitDevicesController::CACHE_TTL / 60).to_i) %>
  </p>
<% end %>
