<% content_for :title, t('.title') %>
<%
  today = Date.current
  # shared time axis of the validity bars: half a year back, a year ahead
  axis_from = today << 6
  axis_to = today >> 12
  axis_pct = ->(date) { ((date - axis_from).to_f / (axis_to - axis_from) * 100).clamp(0, 100).round(2) }
  years = ((axis_from.year + 1)..axis_to.year).map { |y| Date.new(y, 1, 1) }
  selected = Array(@settings.feed_keys)
  used = ->(feed) { selected.empty? || selected.include?(feed.key) }
  feeds = @feeds.sort_by { |feed| [used.call(feed) && selected.any? ? 0 : 1, feed.name.to_s.downcase] }
  missing_attribution = @feeds.count { |feed| feed.attribution.blank? && feed.license_url.blank? }
  status_word = ->(status) { t(".status_#{status}", default: status.to_s) }
  status_dot = ->(status) { { 'ok' => 'bg-success', 'done' => 'bg-success', 'running' => 'bg-info', 'failed' => 'bg-error' }.fetch(status.to_s, 'bg-base-content/30') }
  confidence = (@settings.min_confidence.clamp(0.5, 0.95) * 20).round / 20.0
%>

<div class="min-h-content w-full my-5 px-2">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'settings/navigation' %>
  <%= render 'shared/transit_tabs', active: :settings %>

  <% unless Gtfs.enabled? %>
    <div role="alert" class="alert alert-warning mb-6"><%= transit_icon('triangle-alert') %><span><%= t('.disabled_globally') %></span></div>
  <% end %>

  <%# wide screens: timetables on the left, detection and matching on the right
      (the form is display: contents, so its two sections are grid items) %>
  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_26rem] xl:grid-rows-[auto_1fr] gap-x-4 items-start">
  <%= form_with url: settings_transit_path, method: :patch, scope: :transit, local: true, class: 'contents' do |f| %>
    <section class="card bg-base-200 shadow mb-4 xl:col-start-2 xl:row-start-1" aria-labelledby="transit-detection">
      <div class="card-body p-5 gap-4">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 id="transit-detection" class="font-semibold text-lg"><%= t('.enabled_label') %></h2>
            <p class="text-sm opacity-70 mt-1 max-w-prose"><%= t('.intro') %></p>
          </div>
          <%= f.check_box :enabled, { checked: @settings.enabled?, class: 'toggle toggle-primary mt-1 shrink-0', aria: { labelledby: 'transit-detection' } }, 'true', 'false' %>
        </div>

        <div class="flex flex-wrap items-end gap-x-4 gap-y-2 border-t border-base-300 pt-4">
          <label class="form-control">
            <span class="label-text"><%= t('.min_confidence_label') %></span>
            <%= f.select :min_confidence, (10..19).map { |i| v = i * 0.05; ["#{(v * 100).round}%", v.round(2)] }, { selected: confidence.round(2) },
                         class: 'select select-bordered select-sm min-h-11 tabular-nums' %>
          </label>
          <p class="text-xs opacity-70 max-w-sm pb-1"><%= t('.min_confidence_hint') %></p>
          <div class="flex items-center gap-3 ml-auto">
            <span class="text-sm opacity-70"><%= selected.any? ? t('.feeds_selected', count: selected.size) : t('.feeds_all') %></span>
            <%= f.submit t('.save'), class: 'btn btn-primary btn-sm min-h-11' %>
          </div>
        </div>
      </div>
    </section>

    <section class="card bg-base-200 shadow mb-4 xl:col-start-1 xl:row-start-1 xl:row-span-2" aria-labelledby="transit-feeds">
      <div class="card-body p-5 gap-3">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="transit-feeds" class="font-semibold text-lg"><%= t('.status_title') %></h2>
          <p class="text-xs opacity-70"><%= t('.feeds_hint') %></p>
        </div>

        <% if @feeds.empty? %>
          <p class="text-sm opacity-70"><%= t('.no_feeds') %></p>
        <% else %>
          <fieldset>
            <legend class="sr-only"><%= t('.feeds_label') %></legend>
            <div class="hidden sm:grid grid-cols-[1.5rem_minmax(0,13rem)_minmax(0,1fr)_6.5rem] gap-x-3 items-end text-[10px] opacity-70 tabular-nums" aria-hidden="true">
              <span></span><span class="uppercase tracking-wide"><%= t('.feed_name') %></span>
              <span class="relative h-4">
                <% years.each do |date| %>
                  <span class="absolute bottom-0 -translate-x-1/2" style="left: <%= axis_pct.call(date) %>%"><%= date.year %></span>
                <% end %>
                <span class="absolute bottom-0 -translate-x-1/2 font-semibold opacity-100" style="left: <%= axis_pct.call(today) %>%"><%= t('.today') %></span>
              </span>
              <span class="text-right uppercase tracking-wide"><%= t('.remaining') %></span>
            </div>
            <ul class="flex flex-col divide-y divide-base-300" role="list">
              <% feeds.each do |feed| %>
                <%
                  on = used.call(feed)
                  from = feed.valid_from || axis_from
                  to = feed.valid_until || axis_to
                  left = axis_pct.call(from)
                  width = [axis_pct.call(to) - left, 0.8].max
                  bar = if feed.expired? then 'bg-error'
                        elsif feed.expiring_soon? then 'bg-warning'
                        elsif on then 'bg-primary'
                        else 'bg-base-content/30'
                        end
                  validity = [feed.valid_from, feed.valid_until].compact.map { |d| l(d) }.join(' – ')
                  remaining_tone = if feed.expired? then 'text-error-ink'
                                   elsif feed.expiring_soon? then 'text-warning-ink'
                                   else ''
                                   end
                %>
                <li class="grid grid-cols-[1.5rem_minmax(0,1fr)_auto] sm:grid-cols-[1.5rem_minmax(0,13rem)_minmax(0,1fr)_6.5rem] gap-x-3 gap-y-1 items-center py-2">
                  <%= check_box_tag 'transit[feed_keys][]', feed.key, selected.include?(feed.key),
                                    id: "transit_feed_#{feed.key}", class: 'checkbox checkbox-primary checkbox-sm' %>
                  <span class="flex items-center gap-1.5 min-w-0">
                    <label for="transit_feed_<%= feed.key %>" class="truncate cursor-pointer <%= 'font-semibold' if on && selected.any? %>" title="<%= feed.name %>"><%= feed.name %></label>
                    <% if feed.license_url.present? %>
                      <%= link_to feed.license_url, target: '_blank', rel: 'noopener noreferrer', class: 'opacity-70 hover:opacity-100 shrink-0', title: [feed.attribution.presence, t('.licence')].compact.join(' · ') do %>
                        <%= transit_icon('external-link', 'w-3.5 h-3.5') %><span class="sr-only"><%= t('.licence') %>: <%= feed.name %></span>
                      <% end %>
                    <% elsif feed.attribution.present? %>
                      <span class="opacity-70 shrink-0" title="<%= feed.attribution %>"><%= transit_icon('info', 'w-3.5 h-3.5') %><span class="sr-only"><%= feed.attribution %></span></span>
                    <% end %>
                  </span>
                  <span class="sm:order-last text-right leading-tight whitespace-nowrap <%= remaining_tone %>">
                    <% if feed.valid_until %>
                      <span class="flex items-center justify-end gap-1 text-sm tabular-nums">
                        <% if feed.expired? || feed.expiring_soon? %><%= transit_icon('triangle-alert', 'w-3.5 h-3.5') %><% end %>
                        <%= feed.expired? ? t('transit_feeds.index.expired_ago', count: (today - feed.valid_until).to_i) : t('transit_feeds.index.days_left', count: (feed.valid_until - today).to_i) %>
                      </span>
                      <span class="block text-[11px] opacity-70 tabular-nums"><%= l(feed.valid_until, format: feed.valid_until.year == today.year ? '%m.%d' : '%Y.%m.%d') %></span>
                    <% else %>
                      <span class="text-sm opacity-70">–</span>
                    <% end %>
                  </span>
                  <span class="col-span-2 col-start-2 sm:col-span-1 sm:col-start-auto flex items-center min-w-0">
                    <span class="relative h-2.5 flex-1 rounded-full bg-base-100" title="<%= t('.validity') %>: <%= validity.presence || '–' %>">
                      <span class="absolute inset-y-0 rounded-full <%= bar %>" style="left: <%= left %>%; width: <%= width %>%"></span>
                      <span class="absolute -inset-y-1 w-px bg-base-content/60" style="left: <%= axis_pct.call(today) %>%" aria-hidden="true"></span>
                    </span>
                    <span class="sr-only"><%= t('.validity') %>: <%= validity %></span>
                  </span>
                </li>
              <% end %>
            </ul>
          </fieldset>
          <% if missing_attribution.positive? %>
            <p class="text-xs opacity-70 border-t border-base-300 pt-3"><%= t('.attribution_missing_count', count: missing_attribution) %></p>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="card bg-base-200 shadow mb-6 xl:col-start-2 xl:row-start-2" aria-labelledby="transit-matching">
    <div class="card-body p-5 gap-3">
      <h2 id="transit-matching" class="font-semibold text-lg"><%= t('.matching_title') %></h2>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        <div>
          <div class="text-xs opacity-70"><%= t('.last_match_label') %></div>
          <% if @state&.last_match.present? %>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="w-2.5 h-2.5 rounded-full <%= status_dot.call(@state.last_match['status']) %>" aria-hidden="true"></span>
              <span class="font-semibold tabular-nums"><%= @state.last_match['date'] %></span>
              <span class="text-sm opacity-70"><%= status_word.call(@state.last_match['status']) %></span>
            </div>
          <% else %>
            <div class="text-sm opacity-70 mt-0.5">–</div>
          <% end %>
        </div>
        <div>
          <div class="text-xs opacity-70"><%= t('.backfill_label') %></div>
          <% if @state&.backfill.present? %>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="w-2.5 h-2.5 rounded-full <%= status_dot.call(@state.backfill['status']) %>" aria-hidden="true"></span>
              <span class="font-semibold"><%= status_word.call(@state.backfill['status']) %></span>
              <span class="text-sm opacity-70 tabular-nums"><%= t('.days_done', count: @state.backfill['days_done'].to_i) %></span>
            </div>
          <% else %>
            <div class="text-sm opacity-70 mt-0.5">–</div>
          <% end %>
        </div>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-3 border-t border-base-300 pt-3">
        <p class="text-sm opacity-70 max-w-md"><%= t('.rematch_hint') %></p>
        <%= button_to t('.rematch_button'), rematch_all_settings_transit_path, method: :post,
                      class: 'btn btn-outline btn-warning btn-sm min-h-11', disabled: !@settings.enabled?,
                      form: { data: { turbo_confirm: t('.rematch_confirm') } } %>
      </div>
    </div>
  </section>
  </div>
</div>
