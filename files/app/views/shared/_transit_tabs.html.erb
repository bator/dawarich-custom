<%#
  Tabs of the transit pages, same order everywhere; only the current page is
  highlighted. Full i18n keys: this partial is rendered from several views.
    render 'shared/transit_tabs', active: :rides, days: @days
%>
<%
  # The period is carried over only where the target page accepts it (the
  # pages have different period lists); otherwise the page uses its default.
  days = local_assigns[:days]
  period = ->(periods) { days if periods.include?(days) }
  tabs = [
    [:rides, t('transit_tabs.rides'), transit_segments_path(days: period.call(TransitSegmentsController::PERIODS))],
    [:stats, t('transit_tabs.stats'), transit_stats_path(days: period.call(TransitStatsController::PERIODS))],
    [:commute, t('transit_tabs.commute'), transit_commute_path(days: period.call(TransitCommuteController::PERIODS))],
    [:punctuality, t('transit_tabs.punctuality'), transit_punctuality_path(days: period.call(TransitPunctualityController::PERIODS))],
    [:savings, t('transit_tabs.savings'), transit_savings_path(days: period.call(TransitSavingsController::PERIODS))],
    [:coverage, t('transit_tabs.coverage'), transit_coverage_path(days: period.call(TransitCoverageController::PERIODS))]
  ]
  tabs << [:feeds, t('transit_tabs.feeds'), transit_feeds_path] if current_user.admin?
  tabs << [:settings, t('transit_tabs.settings'), settings_transit_path]
%>
<nav class="overflow-x-auto -mt-3 mb-6" aria-label="<%= t('transit_tabs.label') %>">
  <div class="tabs tabs-boxed w-fit flex-nowrap">
    <% tabs.each do |key, label, path| %>
      <%= link_to label, path, class: "tab whitespace-nowrap #{'tab-active' if key == active}",
                               aria: { current: (key == active ? 'page' : nil) } %>
    <% end %>
  </div>
</nav>
