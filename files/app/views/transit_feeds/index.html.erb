<% content_for :title, t('.title') %>
<%
  stamp = ->(time) { time ? l(time.in_time_zone(@zone), format: '%Y-%m-%d %H:%M') : '–' }
  row_labels = %w[gtfs_stops gtfs_routes gtfs_trips gtfs_stop_times]
%>

<div class="min-h-content w-full my-5 max-w-6xl mx-auto px-2">
  <%= render layout: 'shared/page_header', locals: { title: t('.title') } do %>
    <%= link_to t('transit_feeds.index.rides_link'), transit_segments_path, class: 'btn btn-sm' %>
  <% end %>

  <p class="text-sm opacity-70 mb-4"><%= t('.intro', days: TransitFeedsController::EXPIRY_WARNING_DAYS) %></p>

  <section class="card bg-base-200 shadow mb-6" aria-labelledby="feeds-table">
    <div class="card-body p-4 gap-2">
      <h2 id="feeds-table" class="font-semibold"><%= t('.feeds', count: @feeds.size) %></h2>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th><%= t('.feed') %></th>
              <th><%= t('.state') %></th>
              <th class="text-right"><%= t('.version') %></th>
              <th><%= t('.last_checked') %></th>
              <th><%= t('.last_imported') %></th>
              <th><%= t('.valid') %></th>
              <th class="text-right"><%= t('.rows') %></th>
            </tr>
          </thead>
          <tbody>
            <% @feeds.each do |feed| %>
              <%
                expired = feed.expired?(on: @today)
                expiring = !expired && feed.valid_until.present? && feed.valid_until <= @today + TransitFeedsController::EXPIRY_WARNING_DAYS
                rows = (feed.import_stats || {})['rows'] || {}
              %>
              <tr class="<%= 'opacity-50' unless feed.enabled %>">
                <td>
                  <div class="font-medium"><%= feed.name %></div>
                  <div class="text-xs opacity-60"><%= feed.key %></div>
                </td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    <span class="badge badge-sm <%= feed.enabled ? 'badge-success' : 'badge-ghost' %>">
                      <%= t(feed.enabled ? '.enabled' : '.disabled') %>
                    </span>
                    <% unless feed.idle? %>
                      <span class="badge badge-sm <%= feed.failed? ? 'badge-error' : 'badge-info' %>"><%= t(".status_#{feed.status}") %></span>
                    <% end %>
                  </div>
                  <% if feed.last_error.present? %>
                    <div class="text-xs text-error mt-1 max-w-xs break-words"><%= feed.last_error.truncate(160) %></div>
                  <% end %>
                </td>
                <td class="text-right tabular-nums"><%= feed.imported? ? "v#{feed.active_version}" : '–' %></td>
                <td class="text-xs tabular-nums whitespace-nowrap"><%= stamp.call(feed.last_checked_at) %></td>
                <td class="text-xs tabular-nums whitespace-nowrap"><%= stamp.call(feed.last_imported_at) %></td>
                <td class="whitespace-nowrap">
                  <% if feed.valid_until %>
                    <span class="badge badge-sm tabular-nums <%= expired ? 'badge-error' : (expiring ? 'badge-warning' : 'badge-ghost') %>"
                          title="<%= feed.valid_from %> – <%= feed.valid_until %>">
                      <%= feed.valid_until %>
                    </span>
                    <div class="text-xs opacity-70">
                      <% if expired %>
                        <%= t('.expired_ago', count: (@today - feed.valid_until).to_i) %>
                      <% else %>
                        <%= t('.days_left', count: (feed.valid_until - @today).to_i) %>
                      <% end %>
                    </div>
                  <% else %>
                    –
                  <% end %>
                </td>
                <td class="text-right text-xs tabular-nums whitespace-nowrap">
                  <% if rows.any? %>
                    <% row_labels.each do |table| %>
                      <% next unless rows[table] %>
                      <div><span class="opacity-60"><%= t(".row_#{table.delete_prefix('gtfs_')}") %></span> <%= number_with_delimiter(rows[table], delimiter: ' ') %></div>
                    <% end %>
                  <% else %>
                    –
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <section class="card bg-base-200 shadow" aria-labelledby="feeds-jobs">
      <div class="card-body p-4 gap-2">
        <h2 id="feeds-jobs" class="font-semibold"><%= t('.jobs_title', queue: TransitFeedsController::QUEUE) %></h2>
        <div class="flex flex-wrap gap-2 text-sm">
          <span class="badge badge-info badge-outline"><%= t('.running', count: @running.size) %></span>
          <span class="badge badge-outline"><%= t('.queued', count: @queue_size) %></span>
          <span class="badge <%= @retries.positive? ? 'badge-warning' : 'badge-outline' %>"><%= t('.retries', count: @retries) %></span>
        </div>
        <% if @running.empty? && @queued.empty? %>
          <p class="text-sm opacity-70"><%= t('.no_jobs') %></p>
        <% else %>
          <ul class="flex flex-col gap-1 text-sm" role="list">
            <% @running.each do |work| %>
              <li class="flex justify-between gap-2">
                <span><span class="badge badge-info badge-xs mr-1"></span><%= work.job.display_class %> <span class="opacity-60"><%= work.job.display_args.inspect.truncate(60) %></span></span>
                <span class="text-xs opacity-70 whitespace-nowrap"><%= t('.since', time: time_ago_in_words(work.run_at)) %></span>
              </li>
            <% end %>
            <% @queued.each do |job| %>
              <li class="flex justify-between gap-2">
                <span><span class="badge badge-ghost badge-xs mr-1"></span><%= job.display_class %> <span class="opacity-60"><%= job.display_args.inspect.truncate(60) %></span></span>
                <span class="text-xs opacity-70 whitespace-nowrap"><%= job.enqueued_at ? t('.since', time: time_ago_in_words(job.enqueued_at)) : '' %></span>
              </li>
            <% end %>
            <% if @queue_size > @queued.size %>
              <li class="text-xs opacity-70"><%= t('.more_queued', count: @queue_size - @queued.size) %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>

    <section class="card bg-base-200 shadow" aria-labelledby="feeds-backfills">
      <div class="card-body p-4 gap-2">
        <h2 id="feeds-backfills" class="font-semibold"><%= t('.backfills_title') %></h2>
        <ul class="flex flex-col gap-3" role="list">
          <% @backfills.each do |user, state| %>
            <%
              from = state['from'] && Date.parse(state['from'])
              oldest = state['until'] && Date.parse(state['until'])
              total = from && oldest ? [(from - oldest).to_i + 1, 1].max : nil
              done = state['days_done'].to_i
              percent = total ? [(done * 100.0 / total).round, 100].min : nil
              badge = { 'running' => 'badge-info', 'done' => 'badge-success', 'cancelled' => 'badge-warning' }.fetch(state['status'], 'badge-ghost')
            %>
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-medium"><%= user.display_name %></span>
                <span class="badge badge-sm <%= badge %>"><%= state['status'] ? t(".backfill_#{state['status']}", default: state['status']) : t('.backfill_never') %></span>
              </div>
              <% if state.present? %>
                <% if percent %>
                  <progress class="progress progress-primary w-full" value="<%= percent %>" max="100" aria-label="<%= t('.progress', percent:) %>"></progress>
                <% end %>
                <div class="text-xs opacity-70 tabular-nums">
                  <%= t('.backfill_detail', cursor: state['cursor'] || '–', from: state['from'] || '–', until: state['until'] || '–',
                                            done:, total: total || '?') %>
                  <% if state['finished_at'] %> · <%= t('.finished', time: stamp.call(Time.zone.parse(state['finished_at']))) %>
                  <% elsif state['updated_at'] %> · <%= t('.updated', time: time_ago_in_words(Time.zone.parse(state['updated_at']))) %><% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  </div>
</div>
