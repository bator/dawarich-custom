<% content_for :title, t('.title') %>
<%
  stamp = ->(time) { time ? l(time.in_time_zone(@zone), format: '%Y-%m-%d %H:%M') : '–' }
  # The backfill state is free-form jsonb written by jobs; a bad date must not break the page.
  date = lambda do |value|
    value.present? ? Date.iso8601(value.to_s) : nil
  rescue ArgumentError, TypeError
    nil
  end
  time = lambda do |value|
    value.present? ? Time.zone.iso8601(value.to_s) : nil
  rescue ArgumentError, TypeError
    nil
  end
  warn_days = TransitFeedsController::EXPIRY_WARNING_DAYS
  win_from = @today - TransitFeedsController::WINDOW_PAST
  win_to = @today + TransitFeedsController::WINDOW_FUTURE
  win_days = (win_to - win_from).to_f
  pos = ->(d) { ((d - win_from) / win_days * 100).clamp(0, 100).round(2) }
  # Validity of the timetable alone (bar colour) and the overall state
  # (KPI, sort order), where a failed sync wins.
  validity = lambda do |feed|
    if !feed.imported? || feed.valid_until.nil? then :pending
    elsif feed.expired?(on: @today) then :expired
    elsif feed.valid_until <= @today + warn_days then :expiring
    else :ok
    end
  end
  state = ->(feed) { feed.failed? || feed.last_error.present? ? :failed : validity.call(feed) }
  bar = { ok: 'bg-success', expiring: 'bg-warning', expired: 'bg-error', pending: 'bg-base-content/30' }
  enabled, disabled = @feeds.partition(&:enabled)
  # Most urgent first: expired, then the soonest end of validity.
  enabled = enabled.sort_by { |f| [{ failed: 0, expired: 1, expiring: 2, pending: 3, ok: 4 }.fetch(state.call(f)), f.valid_until || Date.new(9999), f.name] }
  counts = enabled.map { |f| state.call(f) }.tally
  months = (win_from..win_to).select { |d| d.day == 1 }
  # Compact age of the last sync, coloured: up to 26 h fine, up to 72 h late, older stale.
  fresh = lambda do |feed|
    at = feed.last_checked_at || feed.last_imported_at
    return ['opacity-70', '–'] unless at

    age = Time.current - at
    text = if age < 3600 then t('.ago_min', count: (age / 60).round)
           elsif age < 48 * 3600 then t('.ago_h', count: (age / 3600).round)
           else t('.ago_d', count: (age / 86_400).round)
           end
    [age <= 26.hours ? 'text-success-ink' : (age <= 72.hours ? 'text-warning-ink' : 'text-error-ink'), text]
  end
  rows = ->(feed) { ((feed.import_stats || {})['rows'] || {}).slice('gtfs_stops', 'gtfs_routes', 'gtfs_trips').map { |k, v| "#{t(".row_#{k.delete_prefix('gtfs_')}")}: #{number_with_delimiter(v, delimiter: ' ')}" }.join(' · ') }
%>

<div class="min-h-content w-full my-5 max-w-4xl mx-auto px-2">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'shared/transit_tabs', active: :feeds %>

  <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6" aria-label="<%= t('.summary') %>">
    <% [[:ok, 'text-success-ink', 'border-success/30 bg-success/10'], [:expiring, 'text-warning-ink', 'border-warning/40 bg-warning/10'],
        [:expired, 'text-error-ink', 'border-error/40 bg-error/10'], [:failed, 'text-error-ink', 'border-error/40 bg-error/10']].each do |key, text, box| %>
      <% n = counts.fetch(key, 0) %>
      <div class="rounded-box border p-4 <%= n.positive? ? box : 'border-transparent bg-base-200' %>">
        <div class="text-xs uppercase tracking-wide <%= n.positive? ? text : 'opacity-70' %>"><%= t(".kpi_#{key}", days: warn_days) %></div>
        <div class="text-3xl font-bold tabular-nums mt-1"><%= n %></div>
      </div>
    <% end %>
  </section>

  <section class="card bg-base-200 shadow-sm mb-6" aria-labelledby="feeds-timeline">
    <div class="card-body p-5 gap-3">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="feeds-timeline" class="font-semibold"><%= t('.timeline', count: enabled.size) %></h2>
        <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs" role="list">
          <% [[:ok, 'bg-success'], [:expiring, 'bg-warning'], [:expired, 'bg-error']].each do |key, cls| %>
            <li class="flex items-center gap-1.5"><span class="inline-block w-3 h-2 rounded-sm <%= cls %>"></span><%= t(".legend_#{key}", days: warn_days) %></li>
          <% end %>
        </ul>
      </div>

      <div class="grid grid-cols-[minmax(0,9rem)_1fr_4.5rem] gap-x-3 text-[10px] opacity-70 tabular-nums">
        <span></span>
        <span class="relative h-4">
          <% months.each do |m| %>
            <span class="absolute -translate-x-1/2 whitespace-nowrap" style="left: <%= pos.call(m) %>%"><%= l(m, format: '%b') %></span>
          <% end %>
        </span>
        <span class="text-right"><%= t('.freshness') %></span>
      </div>

      <ul class="flex flex-col" role="list">
        <% enabled.each do |feed| %>
          <%
            st = state.call(feed)
            vs = validity.call(feed)
            color, ago = fresh.call(feed)
            from = feed.valid_from
            to = feed.valid_until
            visible = from && to && to >= win_from && from <= win_to
          %>
          <li class="grid grid-cols-[minmax(0,9rem)_1fr_4.5rem] gap-x-3 items-center py-1.5 border-b border-base-300 last:border-b-0">
            <span class="min-w-0" title="<%= [feed.key, rows.call(feed)].compact_blank.join(' · ') %>">
              <span class="block text-sm font-medium truncate"><%= feed.name %></span>
              <span class="block text-[10px] opacity-70 tabular-nums"><%= feed.imported? ? "v#{feed.active_version}" : t('.not_imported') %></span>
            </span>

            <span class="relative h-5 rounded bg-base-100"
                  title="<%= from || '?' %> – <%= to || '?' %><%= to ? " · #{to >= @today ? t('.days_left', count: (to - @today).to_i) : t('.expired_ago', count: (@today - to).to_i)}" : '' %>">
              <% months.each do |m| %>
                <span class="absolute inset-y-0 w-px bg-base-content/10" style="left: <%= pos.call(m) %>%"></span>
              <% end %>
              <% if visible %>
                <% left = pos.call([from, win_from].max) %>
                <% mid = pos.call([[@today, from].max, to].min) %>
                <% right = pos.call([to, win_to].min) %>
                <span class="absolute inset-y-1 <%= bar[vs] %> opacity-50 <%= 'rounded-l' if from >= win_from %>" style="left: <%= left %>%; width: <%= (mid - left).round(2) %>%"></span>
                <span class="absolute inset-y-1 <%= bar[vs] %> <%= 'rounded-r' if to <= win_to %> <%= 'rounded-l' if from > @today %>" style="left: <%= mid %>%; width: <%= (right - mid).round(2) %>%"></span>
                <% if to > win_to %><span class="absolute right-0.5 inset-y-0 flex items-center text-[10px] font-bold text-success-content">→</span><% end %>
                <% if to <= win_to %>
                  <span class="absolute inset-y-0 flex items-center text-[10px] tabular-nums pl-1 whitespace-nowrap <%= vs == :ok ? 'opacity-70' : (vs == :expiring ? 'text-warning-ink' : 'text-error-ink') %>" style="left: <%= right %>%">
                    <%= l(to, format: '%m.%d') %>
                  </span>
                <% end %>
              <% elsif to && to < win_from %>
                <span class="absolute inset-y-0 left-1 flex items-center gap-1 text-[10px] text-error-ink whitespace-nowrap">
                  <span class="inline-block w-1.5 h-3 rounded-sm bg-error"></span><%= t('.expired_ago', count: (@today - to).to_i) %> (<%= to %>)
                </span>
              <% else %>
                <span class="absolute inset-y-0 left-1 flex items-center text-[10px] opacity-70"><%= t('.no_validity') %></span>
              <% end %>
              <span class="absolute -inset-y-1 w-0.5 bg-primary" style="left: calc(<%= pos.call(@today) %>% - 1px)"></span>
            </span>

            <span class="text-right text-xs leading-tight" title="<%= t('.checked') %>: <%= stamp.call(feed.last_checked_at) %> · <%= t('.imported') %>: <%= stamp.call(feed.last_imported_at) %>">
              <% if st == :failed %>
                <span class="badge badge-error badge-sm" title="<%= feed.last_error.to_s.truncate(300) %>"><%= t('.status_failed') %></span>
              <% elsif feed.importing? %>
                <span class="badge badge-info badge-sm"><%= t('.status_importing') %></span>
              <% else %>
                <span class="<%= color %> tabular-nums"><%= ago %></span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
      <div class="grid grid-cols-[minmax(0,9rem)_1fr_4.5rem] gap-x-3 text-[10px] opacity-70">
        <span></span>
        <span class="relative h-3"><span class="absolute -translate-x-1/2 text-primary-ink font-semibold" style="left: <%= pos.call(@today) %>%"><%= t('.today') %></span></span>
        <span></span>
      </div>
      <p class="text-xs opacity-70"><%= t('.timeline_note', past: TransitFeedsController::WINDOW_PAST, future: TransitFeedsController::WINDOW_FUTURE) %></p>
    </div>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <section class="card bg-base-200 shadow-sm" aria-labelledby="feeds-jobs">
      <div class="card-body p-5 gap-3">
        <h2 id="feeds-jobs" class="font-semibold"><%= t('.jobs_title', queue: TransitFeedsController::QUEUE) %></h2>
        <div class="grid grid-cols-3 gap-2 text-center">
          <div class="rounded-box bg-base-100 p-2">
            <div class="text-2xl font-bold tabular-nums <%= 'text-info-ink' if @running.any? %>"><%= @running.size %></div>
            <div class="text-[11px] opacity-70"><%= t('.running_label') %></div>
          </div>
          <div class="rounded-box bg-base-100 p-2">
            <div class="text-2xl font-bold tabular-nums"><%= @queue_size %></div>
            <div class="text-[11px] opacity-70"><%= t('.queued_label') %></div>
          </div>
          <div class="rounded-box bg-base-100 p-2">
            <div class="text-2xl font-bold tabular-nums <%= 'text-warning-ink' if @retries.positive? %>"><%= @retries %><%= '+' if @retries_capped %></div>
            <div class="text-[11px] opacity-70"><%= t('.retries_label') %></div>
          </div>
        </div>
        <% jobs = @running.map { |w| [w.job.display_class, w.job.display_args, w.run_at, true] } + @queued.first(5).map { |j| [j.display_class, j.display_args, j.enqueued_at, false] } %>
        <% if jobs.empty? %>
          <p class="text-sm opacity-70"><%= t('.no_jobs') %></p>
        <% else %>
          <ul class="flex flex-col gap-1 text-xs" role="list">
            <% jobs.each do |klass, args, at, running| %>
              <li class="flex items-center justify-between gap-2" title="<%= args.inspect.truncate(200) %>">
                <span class="flex items-center gap-1.5 min-w-0">
                  <span class="inline-block w-1.5 h-1.5 rounded-full shrink-0 <%= running ? 'bg-info animate-pulse' : 'bg-base-content/30' %>"></span>
                  <span class="truncate"><%= klass.to_s.delete_prefix('Gtfs::') %></span>
                </span>
                <span class="opacity-70 whitespace-nowrap"><%= at ? t('.ago', time: time_ago_in_words(at)) : '' %></span>
              </li>
            <% end %>
            <% if @queue_size > 5 %><li class="opacity-70"><%= t('.more_queued', count: @queue_size - [@queued.size, 5].min) %></li><% end %>
          </ul>
        <% end %>
      </div>
    </section>

    <section class="card bg-base-200 shadow-sm" aria-labelledby="feeds-backfills">
      <div class="card-body p-5 gap-3">
        <h2 id="feeds-backfills" class="font-semibold"><%= t('.backfills_title') %></h2>
        <ul class="flex flex-col gap-3" role="list">
          <% @backfills.each do |user, st| %>
            <%
              from = date.call(st['from'])
              oldest = date.call(st['until'])
              total = from && oldest ? [(from - oldest).to_i + 1, 1].max : nil
              done = st['days_done'].to_i
              percent = total ? [(done * 100.0 / total).round, 100].min : nil
              status = st['status']
              color = { 'running' => 'bg-info', 'done' => 'bg-success', 'cancelled' => 'bg-warning' }.fetch(status, 'bg-base-content/30')
              updated = time.call(st['updated_at'])
              finished = time.call(st['finished_at'])
            %>
            <li class="text-sm"
                title="<%= t('.backfill_detail', cursor: st['cursor'] || '–', from: st['from'] || '–', until: st['until'] || '–', done:, total: total || '?') %>">
              <div class="flex items-baseline justify-between gap-2">
                <span class="font-medium truncate"><%= user.display_name %></span>
                <span class="text-xs whitespace-nowrap <%= status == 'running' ? 'text-info-ink' : 'opacity-70' %>">
                  <%= status ? t(".backfill_#{status}", default: status) : t('.backfill_never') %><%= " · #{percent}%" if percent && status != 'done' %>
                </span>
              </div>
              <% if st.present? %>
                <div class="h-1.5 rounded-full bg-base-100 mt-1 overflow-hidden">
                  <span class="block h-full rounded-full <%= color %>" style="width: <%= status == 'done' ? 100 : (percent || 0) %>%"></span>
                </div>
                <div class="text-[11px] opacity-70 mt-0.5 tabular-nums">
                  <% if status == 'done' && finished %><%= t('.finished', time: stamp.call(finished)) %>
                  <% elsif st['cursor'] %><%= t('.at_day', day: st['cursor']) %><%= " · #{t('.updated', time: time_ago_in_words(updated))}" if updated %><% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  </div>

  <% if disabled.any? %>
    <details class="card bg-base-200 shadow-sm">
      <summary class="card-body p-4 cursor-pointer text-sm list-none [&::-webkit-details-marker]:hidden"><%= t('.disabled_feeds', count: disabled.size) %> ▾</summary>
      <ul class="px-4 pb-4 flex flex-wrap gap-2" role="list">
        <% disabled.each do |feed| %>
          <li class="badge badge-ghost gap-1" title="<%= feed.key %>"><%= feed.name %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
