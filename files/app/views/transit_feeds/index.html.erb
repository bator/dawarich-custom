<% content_for :title, t('.title') %>
<%
  stamp = ->(time) { time ? l(time.in_time_zone(@zone), format: '%Y-%m-%d %H:%M') : '–' }
  # The backfill state is free-form jsonb written by jobs; a bad date must not break the page.
  date = lambda do |value|
    value.present? ? Date.iso8601(value.to_s) : nil
  rescue ArgumentError, TypeError
    nil
  end
  time = lambda do |value|
    value.present? ? Time.zone.iso8601(value.to_s) : nil
  rescue ArgumentError, TypeError
    nil
  end
  warn_days = TransitFeedsController::EXPIRY_WARNING_DAYS
  # Validity of the timetable alone and the overall state, where a failed sync wins.
  validity = lambda do |feed|
    if !feed.imported? || feed.valid_until.nil? then :pending
    elsif feed.expired?(on: @today) then :expired
    elsif feed.valid_until <= @today + warn_days then :expiring
    else :ok
    end
  end
  state = ->(feed) { feed.failed? || feed.last_error.present? ? :failed : validity.call(feed) }
  urgency = { failed: 0, expired: 1, pending: 2, expiring: 3, ok: 4 }
  enabled, disabled = @feeds.partition(&:enabled)
  total = ->(feed) { @usage[:total].fetch(feed.id, 0) }
  recent = ->(feed) { @usage[:recent].fetch(feed.id, 0) }
  # Only problems that matter get a big card (see RELEVANT_DAYS); the others
  # stay small tiles among the unused feeds, problems first.
  relevant = ->(feed) { @usage[:relevant].fetch(feed.id, 0).positive? || @selected_keys.include?(feed.key) }
  by_urgency = ->(f) { [urgency.fetch(state.call(f)), f.valid_until || Date.new(9999), f.name] }
  attention, rest = enabled.partition { |f| state.call(f) != :ok && relevant.call(f) }
  attention = attention.sort_by(&by_urgency)
  used, standby = rest.partition { |f| state.call(f) == :ok && total.call(f).positive? }
  used = used.sort_by { |f| [-recent.call(f), -total.call(f), f.name] }
  standby = standby.sort_by(&by_urgency)
  # Compact age of a time, coloured: up to 26 h fine, up to 72 h late, older stale.
  age_of = lambda do |at|
    return ['opacity-70', '–'] unless at

    age = Time.current - at
    text = if age < 3600 then t('.ago_min', count: (age / 60).round)
           elsif age < 48 * 3600 then t('.ago_h', count: (age / 3600).round)
           else t('.ago_d', count: (age / 86_400).round)
           end
    [age <= 26.hours ? 'text-success-ink' : (age <= 72.hours ? 'text-warning-ink' : 'text-error-ink'), text]
  end
  synced = ->(feed) { feed.last_checked_at || feed.last_imported_at }
  left_text = lambda do |feed|
    to = feed.valid_until
    next t('.no_validity') unless to

    to >= @today ? t('.days_left', count: (to - @today).to_i) : t('.expired_ago', count: (@today - to).to_i)
  end
  tone = { ok: 'text-success-ink', expiring: 'text-warning-ink', expired: 'text-error-ink', failed: 'text-error-ink', pending: 'opacity-70' }
  stroke = { ok: 'var(--success-ink)', expiring: 'var(--warning-ink)', expired: 'var(--error-ink)', failed: 'var(--error-ink)', pending: 'currentColor' }
  # Remaining share of the active version's validity, as a small ring.
  ring = lambda do |feed, size: 30|
    from = feed.valid_from
    to = feed.valid_until
    share = from && to && to > from ? ((to - @today).to_f / (to - from)).clamp(0, 1) : 0
    r = 12
    c = (2 * Math::PI * r).round(2)
    tag.svg(viewBox: '0 0 30 30', width: size, height: size, class: 'shrink-0 -rotate-90', 'aria-hidden': true) do
      safe_join([tag.circle(cx: 15, cy: 15, r:, fill: 'none', stroke: 'currentColor', 'stroke-opacity': 0.15, 'stroke-width': 4),
                 tag.circle(cx: 15, cy: 15, r:, fill: 'none', stroke: stroke[validity.call(feed)], 'stroke-width': 4,
                            'stroke-linecap': 'round', 'stroke-dasharray': "#{(c * share).round(2)} #{c}")])
    end
  end
  modes = ->(feed) { (@routes.dig(feed.id, :modes) || {}).sort_by { |_, n| -n }.map(&:first) }
  mode_icons = lambda do |feed, css = 'w-4 h-4'|
    content_tag(:span, safe_join(modes.call(feed).first(4).map { |m| content_tag(:span, transit_mode_icon(m, css), title: t("transit_modes.#{m}")) }),
                class: 'flex items-center gap-1 opacity-70 shrink-0')
  end
  # status strip
  newest_sync = enabled.filter_map { |f| synced.call(f) }.max
  sync_tone, sync_ago = age_of.call(newest_sync)
  queue_busy = @running.any? || @queue_size.positive?
  backfill_states = @backfills.map { |_, st| st['status'] }
  backfills_running = backfill_states.count('running')
  backfills_done = backfill_states.count('done')
  jobs = @running.map { |w| [w.job.display_class, w.job.display_args, w.run_at, true] } +
         @queued.first(5).map { |j| [j.display_class, j.display_args, j.enqueued_at, false] }
  dot = ->(cls) { tag.span(class: "inline-block w-2 h-2 rounded-full shrink-0 #{cls}", 'aria-hidden': true) }
%>

<div class="min-h-content w-full my-5 px-2">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'shared/transit_tabs', active: :feeds %>

  <%# One line of system state; the job and backfill lists open on demand (open while something runs) %>
  <details class="card bg-base-200 shadow-sm mb-6 group" <%= 'open' if queue_busy || backfills_running.positive? || @retries.positive? %>>
    <summary class="card-body p-4 flex-row flex-wrap items-center gap-x-8 gap-y-2 text-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <span class="flex items-center gap-2" title="<%= stamp.call(newest_sync) %>">
        <%= dot.call(sync_tone.sub('text-', 'bg-').sub('-ink', '')) %><span class="opacity-70"><%= t('.strip_sync') %></span><span class="font-semibold <%= sync_tone %>"><%= sync_ago %></span>
      </span>
      <span class="flex items-center gap-2">
        <%= dot.call(@retries.positive? ? 'bg-warning' : (queue_busy ? 'bg-info animate-pulse' : 'bg-success')) %>
        <span class="opacity-70"><%= t('.strip_queue', queue: TransitFeedsController::QUEUE) %></span>
        <span class="font-semibold">
          <% if queue_busy || @retries.positive? %>
            <%= [(t('.strip_running', count: @running.size) if @running.any?), (t('.strip_queued', count: @queue_size) if @queue_size.positive?),
                 (t('.strip_retries', count: @retries) if @retries.positive?)].compact.join(' · ') %>
          <% else %>
            <%= t('.strip_idle') %>
          <% end %>
        </span>
      </span>
      <span class="flex items-center gap-2">
        <%= dot.call(backfills_running.positive? ? 'bg-info animate-pulse' : 'bg-success') %>
        <span class="opacity-70"><%= t('.strip_history') %></span>
        <span class="font-semibold"><%= backfills_running.positive? ? t('.strip_history_running', count: backfills_running) : t('.strip_history_done', done: backfills_done, total: @backfills.size) %></span>
      </span>
      <span class="ml-auto flex items-center gap-3 text-xs opacity-70">
        <span><%= t('.strip_feeds', count: enabled.size) %></span>
        <span class="flex items-center gap-1 group-open:rotate-180 transition-transform"><%= transit_icon('chevron-down', 'w-4 h-4') %></span>
      </span>
    </summary>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 px-5 pb-5 border-t border-base-300 pt-4">
      <section aria-labelledby="feeds-jobs">
        <h2 id="feeds-jobs" class="text-xs uppercase tracking-wide opacity-70 mb-2"><%= t('.jobs_title', queue: TransitFeedsController::QUEUE) %></h2>
        <% if jobs.empty? %>
          <p class="text-sm opacity-70"><%= t('.no_jobs') %></p>
        <% else %>
          <ul class="flex flex-col gap-1 text-xs" role="list">
            <% jobs.each do |klass, args, at, running| %>
              <li class="flex items-center justify-between gap-2" title="<%= args.inspect.truncate(200) %>">
                <span class="flex items-center gap-1.5 min-w-0"><%= dot.call(running ? 'bg-info animate-pulse' : 'bg-base-content/30') %><span class="truncate"><%= klass.to_s.delete_prefix('Gtfs::') %></span></span>
                <span class="opacity-70 whitespace-nowrap"><%= at ? t('.ago', time: time_ago_in_words(at)) : '' %></span>
              </li>
            <% end %>
            <% if @queue_size > 5 %><li class="opacity-70"><%= t('.more_queued', count: @queue_size - [@queued.size, 5].min) %></li><% end %>
          </ul>
        <% end %>
      </section>
      <section aria-labelledby="feeds-backfills">
        <h2 id="feeds-backfills" class="text-xs uppercase tracking-wide opacity-70 mb-2"><%= t('.backfills_title') %></h2>
        <ul class="flex flex-col gap-1.5" role="list">
          <% @backfills.each do |user, st| %>
            <%
              from = date.call(st['from'])
              oldest = date.call(st['until'])
              days = from && oldest ? [(from - oldest).to_i + 1, 1].max : nil
              done = st['days_done'].to_i
              percent = days ? [(done * 100.0 / days).round, 100].min : nil
              status = st['status']
              finished = time.call(st['finished_at'])
            %>
            <li class="flex items-center gap-3 text-sm"
                title="<%= t('.backfill_detail', cursor: st['cursor'] || '–', from: st['from'] || '–', until: st['until'] || '–', done:, total: days || '?') %>">
              <span class="font-medium truncate min-w-0 flex-1"><%= user.display_name %></span>
              <% if status == 'running' %>
                <span class="w-24 h-1.5 rounded-full bg-base-100 overflow-hidden"><span class="block h-full bg-info" style="width: <%= percent || 0 %>%"></span></span>
                <span class="text-xs text-info-ink tabular-nums w-10 text-right"><%= percent %>%</span>
              <% else %>
                <span class="text-xs opacity-70 whitespace-nowrap"><%= status ? t(".backfill_#{status}", default: status) : t('.backfill_never') %><%= " · #{l(finished.in_time_zone(@zone), format: '%m.%d')}" if status == 'done' && finished %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    </div>
  </details>

  <% if attention.any? %>
    <section class="mb-6" aria-labelledby="feeds-attention">
      <h2 id="feeds-attention" class="flex items-center gap-2 font-semibold text-lg mb-3">
        <%= transit_icon('triangle-alert', 'w-5 h-5 text-warning-ink') %><%= t('.attention_title') %>
        <span class="badge badge-sm badge-warning"><%= attention.size %></span>
        <span class="text-xs font-normal opacity-70"><%= t('.attention_note') %></span>
      </h2>
      <% attention_cols = { 1 => 'xl:grid-cols-2', 2 => 'xl:grid-cols-2', 3 => 'xl:grid-cols-3' }.fetch(attention.size, 'xl:grid-cols-4') %>
      <ul class="grid grid-cols-1 sm:grid-cols-2 <%= attention_cols %> gap-4" role="list">
        <% attention.each do |feed| %>
          <% st = state.call(feed) %>
          <li class="rounded-box border p-4 flex flex-col gap-2 <%= %i[failed expired].include?(st) ? 'border-error/40 bg-error/10' : 'border-warning/40 bg-warning/10' %>"
              title="<%= feed.key %> · <%= t('.checked') %>: <%= stamp.call(feed.last_checked_at) %>">
            <div class="flex items-center justify-between gap-2">
              <span class="font-semibold truncate"><%= feed.name %></span><%= mode_icons.call(feed) %>
            </div>
            <div class="text-2xl font-bold leading-tight <%= tone[st] %>">
              <%= st == :failed ? t('.status_failed') : (st == :pending ? t('.not_imported') : left_text.call(feed)) %>
            </div>
            <% if st == :failed && feed.last_error.present? %>
              <p class="text-xs font-mono opacity-80 line-clamp-2"><%= feed.last_error.to_s.truncate(160) %></p>
            <% end %>
            <div class="text-xs opacity-70 flex flex-wrap gap-x-2">
              <% if feed.valid_until %><span class="tabular-nums"><%= t('.valid_until', date: l(feed.valid_until, format: '%Y.%m.%d')) %></span><% end %>
              <% if feed.imported? %><span>v<%= feed.active_version %></span><% end %>
              <span><%= total.call(feed).positive? ? t('.used_by', count: total.call(feed)) : t('.unused') %></span>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if used.any? %>
    <section class="mb-6" aria-labelledby="feeds-used">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
        <h2 id="feeds-used" class="font-semibold text-lg"><%= t('.used_title') %></h2>
        <p class="text-xs opacity-70"><%= t('.used_note', days: TransitFeedsController::USAGE_DAYS) %></p>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" role="list">
        <% used.each do |feed| %>
          <%
            weeks = @usage[:weekly][feed.id] || Array.new(TransitFeedsController::SPARK_WEEKS, 0)
            peak = [weeks.max, 1].max
            sync_cls, sync_text = age_of.call(synced.call(feed))
            routes = @routes.dig(feed.id, :count).to_i
          %>
          <li class="card bg-base-200 shadow-sm">
            <div class="card-body p-5 gap-4">
              <div class="flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="font-semibold truncate" title="<%= feed.key %>"><%= feed.name %></h3>
                  <p class="text-xs opacity-70"><%= t('.routes', count: routes) %> · v<%= feed.active_version %></p>
                </div>
                <%= mode_icons.call(feed, 'w-5 h-5') %>
              </div>

              <div class="flex items-end justify-between gap-4">
                <div class="shrink-0">
                  <div class="text-3xl font-bold tabular-nums leading-none"><%= recent.call(feed) %></div>
                  <div class="text-xs opacity-70 mt-1"><%= t('.rides_recent', days: TransitFeedsController::USAGE_DAYS) %> · <%= t('.rides_total', count: total.call(feed)) %></div>
                </div>
                <ol class="flex items-end gap-[3px] h-10 flex-1 max-w-[12rem]" role="list" aria-label="<%= t('.weekly_label', weeks: weeks.size) %>">
                  <% weeks.each_with_index do |n, i| %>
                    <li class="flex-1 rounded-sm <%= n.positive? ? 'bg-primary' : 'bg-base-content/15' %>"
                        style="height: <%= n.positive? ? [(n * 100.0 / peak).round, 12].max : 6 %>%"
                        title="<%= l(@usage[:week_start] + (i * 7), format: '%m.%d') %>: <%= t('.rides_total', count: n) %>"></li>
                  <% end %>
                </ol>
              </div>

              <% lines = @usage[:lines][feed.id] || [] %>
              <% if lines.any? %>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                  <% lines.each do |segment, n| %>
                    <span class="flex items-center gap-1"><%= transit_line_badge(segment, @colors, extra_class: 'badge-sm') %><span class="text-[11px] opacity-70 tabular-nums">×<%= n %></span></span>
                  <% end %>
                </div>
              <% end %>

              <div class="flex items-center justify-between gap-3 border-t border-base-300 pt-3 text-sm">
                <span class="flex items-center gap-2 min-w-0" title="<%= feed.valid_from %> – <%= feed.valid_until %>">
                  <%= ring.call(feed) %>
                  <span class="min-w-0">
                    <span class="block font-medium <%= tone[validity.call(feed)] %>"><%= left_text.call(feed) %></span>
                    <span class="block text-[11px] opacity-70 tabular-nums"><%= l(feed.valid_until, format: '%Y.%m.%d') if feed.valid_until %></span>
                  </span>
                </span>
                <span class="text-xs text-right" title="<%= t('.checked') %>: <%= stamp.call(feed.last_checked_at) %> · <%= t('.imported') %>: <%= stamp.call(feed.last_imported_at) %>">
                  <span class="block opacity-70"><%= t('.synced') %></span>
                  <span class="<%= sync_cls %> tabular-nums"><%= feed.importing? ? t('.status_importing') : sync_text %></span>
                </span>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if standby.any? %>
    <section class="mb-6" aria-labelledby="feeds-standby">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
        <h2 id="feeds-standby" class="font-semibold text-lg"><%= t('.standby_title') %> <span class="opacity-60 font-normal"><%= standby.size %></span></h2>
        <p class="text-xs opacity-70"><%= t('.standby_note') %></p>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 gap-2" role="list">
        <% standby.each do |feed| %>
          <% sync_cls, sync_text = age_of.call(synced.call(feed)) %>
          <li class="rounded-box bg-base-200 px-3 py-2.5 flex items-center gap-3"
              title="<%= feed.key %> · <%= feed.valid_from %> – <%= feed.valid_until %> · <%= left_text.call(feed) %> · <%= t('.synced') %>: <%= sync_text %><%= " · #{feed.last_error.to_s.truncate(200)}" if feed.last_error.present? %>">
            <%= ring.call(feed, size: 26) %>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium truncate"><%= feed.name %></span>
              <span class="flex items-center gap-1.5 text-[11px] opacity-70">
                <%= mode_icons.call(feed, 'w-3 h-3') %><span class="tabular-nums"><%= t('.routes', count: @routes.dig(feed.id, :count).to_i) %></span>
              </span>
            </span>
            <% st = state.call(feed) %>
            <span class="text-xs tabular-nums whitespace-nowrap <%= tone[st] %> <%= 'font-semibold' unless st == :ok %>">
              <% if st == :failed %><%= t('.status_failed') %>
              <% elsif st == :pending %><%= t('.not_imported') %>
              <% elsif st == :expired %><%= t('.expired_short') %>
              <% else %><%= t('.days_short', count: (feed.valid_until - @today).to_i) %><% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if disabled.any? %>
    <details class="card bg-base-200 shadow-sm">
      <summary class="card-body p-4 cursor-pointer text-sm list-none [&::-webkit-details-marker]:hidden"><%= t('.disabled_feeds', count: disabled.size) %> ▾</summary>
      <ul class="px-4 pb-4 flex flex-wrap gap-2" role="list">
        <% disabled.each do |feed| %>
          <li class="badge badge-ghost gap-1" title="<%= feed.key %>"><%= feed.name %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
