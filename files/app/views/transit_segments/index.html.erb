<% content_for :title, t('.title') %>
<%
  hours_minutes = lambda do |seconds|
    minutes = (seconds / 60.0).round
    minutes >= 60 ? t('.hours_minutes', hours: minutes / 60, minutes: minutes % 60) : t('transit_segments.card.minutes', count: minutes)
  end
  filter_params = ->(extra = {}) { { days: @days, uncertain: (@only_uncertain ? '1' : nil) }.merge(extra).compact }
%>

<div class="min-h-content w-full my-5 max-w-4xl mx-auto px-2">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'shared/transit_tabs', active: :rides, days: @days %>

  <% unless @enabled %>
    <div role="alert" class="alert alert-info mb-6">
      <span><%= t('.disabled') %></span>
      <%= link_to t('.settings_link'), settings_transit_path, class: 'btn btn-sm' %>
    </div>
  <% end %>

  <section class="mb-4" aria-label="<%= t('.summary_label') %>">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-box bg-base-200 p-4">
        <div class="text-xs uppercase tracking-wide opacity-60"><%= t('.rides', count: @summary[:count]) %></div>
        <div class="text-2xl sm:text-3xl font-bold tabular-nums mt-1"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-box bg-base-200 p-4">
        <div class="text-xs uppercase tracking-wide opacity-60"><%= t('.on_board') %></div>
        <div class="text-2xl sm:text-3xl font-bold tabular-nums mt-1"><%= hours_minutes.call(@summary[:duration_s]) %></div>
      </div>
      <div class="rounded-box bg-base-200 p-4">
        <div class="text-xs uppercase tracking-wide opacity-60"><%= t('.distance') %></div>
        <div class="text-2xl sm:text-3xl font-bold tabular-nums mt-1"><%= number_with_precision(@summary[:distance_m] / 1000.0, precision: 0, delimiter: ' ') %> km</div>
      </div>
      <% if @summary[:uncertain].positive? %>
        <%= link_to transit_segments_path(days: @days, uncertain: (@only_uncertain ? nil : '1')),
                    class: "rounded-box p-4 border-2 border-warning hover:bg-warning/10 #{@only_uncertain ? 'bg-warning/20' : 'bg-warning/5'}",
                    title: t('.uncertain_note', count: @summary[:uncertain]) do %>
          <div class="text-xs uppercase tracking-wide text-warning">⚠ <%= t('.review_tile') %></div>
          <div class="text-2xl sm:text-3xl font-bold tabular-nums mt-1"><%= @summary[:uncertain] %></div>
        <% end %>
      <% else %>
        <div class="rounded-box bg-success/10 p-4">
          <div class="text-xs uppercase tracking-wide text-success">✔ <%= t('.review_tile') %></div>
          <div class="text-lg font-semibold mt-2"><%= t('.all_reviewed') %></div>
        </div>
      <% end %>
    </div>
    <% if @summary[:by_mode].any? %>
      <ul class="flex flex-wrap gap-2 mt-3" role="list">
        <% @summary[:by_mode].each do |mode, count| %>
          <li class="badge badge-lg gap-1.5 bg-base-200 border-0 py-3">
            <span aria-hidden="true"><%= Gtfs::Discord::MessageBuilder::EMOJI.fetch(mode) %></span>
            <span class="text-sm"><%= t("transit_modes.#{mode}") %></span>
            <span class="font-semibold tabular-nums"><%= count %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <%= form_with url: transit_segments_path, method: :get, local: true, class: 'flex flex-wrap items-end gap-3 mb-6' do %>
    <label class="form-control">
      <span class="label-text"><%= t('.period') %></span>
      <%= select_tag :days, options_for_select(TransitSegmentsController::PERIODS.map { |d| [t('.days', count: d), d] }, @days),
                     class: 'select select-bordered select-sm min-h-11' %>
    </label>
    <label class="label cursor-pointer gap-2 min-h-11">
      <%= check_box_tag :uncertain, '1', @only_uncertain, class: 'checkbox checkbox-sm' %>
      <span class="label-text"><%= t('.show_uncertain') %></span>
    </label>
    <%= submit_tag t('.filter'), class: 'btn btn-primary btn-sm min-h-11', name: nil %>
    <span class="text-sm opacity-70 ml-auto"><%= t('.total', count: @total) %></span>
  <% end %>

  <% if @segments.empty? %>
    <p class="opacity-70"><%= t(@only_uncertain ? '.empty_uncertain' : '.empty') %></p>
  <% else %>
    <div class="flex flex-col gap-8">
      <% @by_day.each do |date, segments| %>
        <section aria-labelledby="day-<%= date.iso8601 %>">
          <header class="flex items-baseline justify-between gap-2 mb-3">
            <h2 id="day-<%= date.iso8601 %>" class="text-sm font-bold uppercase tracking-wide">
              <%= date == @zone.today ? t('.today') : (date == @zone.today - 1 ? t('.yesterday') : l(date, format: '%A')) %>
              <span class="opacity-60 font-normal normal-case tracking-normal ml-1"><%= l(date, format: :long) %></span>
            </h2>
            <span class="text-xs opacity-70 whitespace-nowrap">
              <%= t('.day_rides', count: segments.size) %> · <%= hours_minutes.call(segments.sum { |s| s.ended_at - s.started_at }) %>
            </span>
          </header>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3" role="list">
            <% segments.sort_by(&:started_at).each do |segment| %>
              <%= render 'card', segment:, colors: @colors, zone: @zone, filter: filter_params.call(page: @page) %>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  <% end %>

  <% if @total > TransitSegmentsController::PER_PAGE %>
    <nav class="join mt-6 flex justify-center" aria-label="pagination">
      <% if @page > 1 %>
        <%= link_to t('.previous'), transit_segments_path(filter_params.call(page: @page - 1)), class: 'join-item btn' %>
      <% end %>
      <% if @page * TransitSegmentsController::PER_PAGE < @total %>
        <%= link_to t('.next'), transit_segments_path(filter_params.call(page: @page + 1)), class: 'join-item btn' %>
      <% end %>
    </nav>
  <% end %>
</div>
